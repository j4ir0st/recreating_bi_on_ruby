<div class="dashboard-container" data-controller="dashboard">
  <!-- Header -->
  <!-- Header: Row 1 (Title & User) -->
  <div class="header" style="justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid var(--border-color); padding-bottom: 15px;">
    <div class="header-left">
      <h1>Calculador de Comisiones</h1>
      <p>Gestiona y calcula comisiones de vendedores por mes</p>
    </div>
    <div class="header-right" style="display: flex; flex-direction: column; align-items: flex-end; gap: 8px;">
      <div class="welcome-msg" style="color: var(--accent-cyan); font-weight: 600; font-size: 0.95rem; white-space: nowrap;">
        Bienvenido, <%= session[:first_name].present? ? "#{session[:first_name]} #{session[:last_name]}" : (session[:username] || "Usuario") %>
      </div>
      <%= button_to "Cerrar Sesión", logout_path, method: :delete, class: "btn-logout", style: "background: transparent; border: 1px solid var(--accent-orange); color: var(--accent-orange); padding: 4px 12px; border-radius: 6px; font-size: 0.75rem; cursor: pointer; transition: var(--transition);" %>
    </div>
  </div>

  <!-- Header: Row 2 (Filters) -->
  <div class="filters-container" style="margin-bottom: 24px;">
    <form id="filter-form">
      <div class="filters-panel" style="display: flex; flex-wrap: wrap; gap: 15px; align-items: flex-end;">
        <div class="filter-group" style="flex: 0 0 150px;">
          <label>Año</label>
          <div class="multiselect-container">
            <div class="multiselect-trigger" data-action="click->dashboard#toggleDropdown">
              <span><%= @selected_years.length > 1 ? @selected_years.sort.join(', ') : (@selected_years.first || Date.today.year.to_s) %></span>
              <svg width="12" height="12" viewBox="0 0 12 12"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2"/></svg>
            </div>
            <div class="multiselect-dropdown">
              <% (@years || []).each_with_index do |year, i| %>
                <div class="multiselect-option">
                  <input type="checkbox" name="year[]" value="<%= year %>" id="year_<%= i %>"
                         <%= 'checked' if @selected_years.include?(year) %>>
                  <label for="year_<%= i %>"><%= year %></label>
                </div>
              <% end %>
            </div>
          </div>
        </div>
          <!-- Filtro Rango de Fechas (Date Range Picker) -->
          <div class="filter-group" style="flex: 1; min-width: 200px;">
            <label>Rango de Fechas</label>
            <button type="button" class="drp-trigger"
                    data-drp-trigger
                    data-drp-start="drp-date-start"
                    data-drp-end="drp-date-end">
              <span class="drp-label">Rango de fechas</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
            </button>
            <!-- Hidden inputs that carry date_start / date_end in the form -->
            <input type="hidden" id="drp-date-start" name="date_start" value="<%= params[:date_start] %>">
            <input type="hidden" id="drp-date-end"   name="date_end"   value="<%= params[:date_end] %>">
          </div>

          <!-- Filtro Vendedores (Custom Multiselect) -->
          <div class="filter-group" style="flex: 3; min-width: 350px;">
            <label>Vendedores</label>
            <div class="multiselect-container">
              <div class="multiselect-trigger" data-action="click->dashboard#toggleDropdown" data-dashboard-target="vendorTrigger">
                <span><%= @selected_vendors.empty? ? '— Sin selección (resumen)' : (@selected_vendors.include?('Todas') ? 'Todas' : (@selected_vendors.length > 2 ? "#{@selected_vendors.length} Vendedores" : @selected_vendors.join(', '))) %></span>
                <svg width="12" height="12" viewBox="0 0 12 12"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2"/></svg>
              </div>
              <div class="multiselect-dropdown">
                <!-- Opción especial: Todas (muestra detalle de todos los vendedores) -->
                <div class="multiselect-option" style="border-bottom: 1px solid var(--border); margin-bottom: 4px; padding-bottom: 6px;">
                  <input type="checkbox" name="vendor[]" value="Todas" id="vendor_todas"
                         <%= 'checked' if @selected_vendors.include?('Todas') %>>
                  <label for="vendor_todas" style="font-weight: 600; color: var(--accent-cyan);">Todas</label>
                </div>
                <% (@vendors || []).each_with_index do |vendor, i| %>
                  <div class="multiselect-option">
                    <input type="checkbox" name="vendor[]" value="<%= vendor %>" id="vendor_<%= i %>"
                           <%= 'checked' if @selected_vendors.include?(vendor) %>>
                    <label for="vendor_<%= i %>"><%= vendor %></label>
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <div class="filter-group" style="flex: 1; min-width: 120px;">
            <label>Cancelado</label>
            <select name="cancelado" data-dashboard-target="canceladoSelect" data-action="change->dashboard#filterChanged">
              <%# <option value="Todo" <%= 'selected' if @selected_cancelado == 'Todo' # }>Todo</option> %> 
              <option value="S" <%= 'selected' if @selected_cancelado == 'S' %>>S</option>
              <option value="N" <%= 'selected' if @selected_cancelado == 'N' %>>N</option>
            </select>
          </div>

          <!-- Filtro Comisión Pagada -->
          <div class="filter-group" style="flex: 1; min-width: 120px;">
            <label>Pago Comisión</label>
            <% current_pagada = params[:comision_pagada].presence || (@active_tab == "supervisor" ? "N" : "Todo") %>
            <select name="comision_pagada" data-dashboard-target="comisionPagadaSelect" data-action="change->dashboard#filterChanged">
              <option value="Todo" <%= 'selected' if current_pagada == 'Todo' %>>Todo</option>
              <option value="S" <%= 'selected' if current_pagada == 'S' %>>Pagada</option>
              <option value="N" <%= 'selected' if current_pagada == 'N' %>>Pendiente</option>
            </select>
          </div>
        </div>
    </form>
  </div>

  <!-- Tabs + Filtros de Historial en la misma fila -->
  <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 12px;">
    <div class="tabs" style="flex: 0 0 auto; overflow-x: auto; white-space: nowrap; max-width: 100%;">
      <button class="tab-btn <%= 'active' if @active_tab == 'vendedor' %>"
              data-tab="vendedor"
              data-action="click->dashboard#switchTab">Vendedor</button>
      <button class="tab-btn <%= 'active' if @active_tab == 'productos' %>"
              data-tab="productos"
              data-action="click->dashboard#switchTab">Productos</button>
      <button class="tab-btn <%= 'active' if @active_tab == 'supervisor' %>"
              data-tab="supervisor"
              data-action="click->dashboard#switchTab">Supervisor</button>
      <button class="tab-btn <%= 'active' if @active_tab == 'reporte' %>"
              data-tab="reporte"
              data-action="click->dashboard#switchTab">Reportes</button>
      <button class="tab-btn <%= 'active' if @active_tab == 'historial' %>"
              data-tab="historial"
              data-action="click->dashboard#switchTab">Historial</button>
    </div>

    <!-- Filtros exclusivos del Historial (ocultos en otras pestañas) -->
    <div id="historial-filters"
         style="display: <%= @active_tab == 'historial' ? 'flex' : 'none' %>;
                margin-left: auto; gap: 8px; align-items: center; flex-wrap: nowrap;">
      <div class="filter-group" style="min-width: 160px;">
        <label style="font-size:0.7rem;">Comprobantes</label>
        <input type="text" id="filter-comprobantes" placeholder="Ej: F003-16650"
               value="<%= params[:comprobantes_filter] %>"
               style="width:100%; background:transparent; border:none; color:var(--text-primary);
                      font-family:'Inter',sans-serif; font-size:0.85rem; outline:none; padding:6px 0;">
      </div>
      <div class="filter-group" style="min-width: 140px;">
        <label style="font-size:0.7rem;">Usuario</label>
        <input type="text" id="filter-usuario" placeholder="Ej: Jairo"
               value="<%= params[:usuario_filter] %>"
               style="width:100%; background:transparent; border:none; color:var(--text-primary);
                      font-family:'Inter',sans-serif; font-size:0.85rem; outline:none; padding:6px 0;">
      </div>
    </div>
  </div>

  <script>
  // Mostrar/ocultar filtros de historial según pestaña activa
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.tab-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var filters = document.getElementById('historial-filters');
        if (filters) filters.style.display = this.dataset.tab === 'historial' ? 'flex' : 'none';
      });
    });

    // Debounce helper
    function debounce(fn, delay) {
      var t;
      return function() { clearTimeout(t); t = setTimeout(fn, delay); };
    }

    // Recargar historial cuando se escribe en los filtros
    function reloadHistorial() {
      var comprobantes = (document.getElementById('filter-comprobantes') || {}).value || '';
      var usuario = (document.getElementById('filter-usuario') || {}).value || '';
      var event = new CustomEvent('historial:filter', { detail: { comprobantes: comprobantes, usuario: usuario } });
      document.dispatchEvent(event);
    }

    var debouncedReload = debounce(reloadHistorial, 400);
    var fc = document.getElementById('filter-comprobantes');
    var fu = document.getElementById('filter-usuario');
    if (fc) fc.addEventListener('input', debouncedReload);
    if (fu) fu.addEventListener('input', debouncedReload);
  });
  </script>


  <!-- KPI Cards removed as per user request -->

  <!-- Tab Content -->
  <div data-dashboard-target="content">
    <% if @active_tab == "vendedor" %>
      <%= render partial: "dashboard/tabs/vendedor", locals: { dashboard: @dashboard, vendor_data: @vendor_data } %>
    <% elsif @active_tab == "productos" %>
      <%= render partial: "dashboard/tabs/productos", locals: { dashboard: @dashboard, details: @product_details } %>
    <% elsif @active_tab == "reporte" %>
      <%= render partial: "dashboard/tabs/reporte", locals: { dashboard: @dashboard, monthly_data: @monthly_data } %>
    <% elsif @active_tab == "historial" %>
      <%= render partial: "dashboard/tabs/historial", locals: {
        audit_history: @audit_history,
        usuario_filter: params[:usuario_filter].to_s,
        comprobantes_filter: params[:comprobantes_filter].to_s
      } %>
    <% elsif @active_tab == "supervisor" %>
      <%= render partial: "dashboard/tabs/supervisor", locals: { supervisor_rows: @supervisor_rows || [] } %>
    <% end %>
  </div>
</div>
