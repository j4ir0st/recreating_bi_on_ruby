<!-- Historial Tab: Registro de Cambios en Comisiones -->
<div class="table-section" style="height: calc(100vh - 250px); flex-shrink: 0; display: flex; flex-direction: column; min-height: 0;">
  <div class="table-header" style="display: flex; justify-content: space-between; align-items: center; padding: 4px 12px; margin: 0px;">
    <div>
      <div style="display: flex; align-items: center; gap: 10px;">
        <h3>Historial de Auditoría</h3>
        <!-- Botón activar modo selección: lápiz cuando inactivo, checkmark cuando activo -->
        <button id="audit-select-btn" onclick="toggleAuditSelection()"
                style="background:none; border:none; color:var(--accent-cyan); cursor:pointer;
                       display:flex; align-items:center; padding:5px;" title="Seleccionar filas para exportar">
          <!-- Lápiz (estado inicial) -->
          <svg id="audit-select-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
        </button>
      </div>
      <p>Registro cronológico de actualizaciones de comisiones pagadas</p>
    </div>
    <!-- Botón Excel (oculto hasta activar modo selección) -->
    <button id="audit-excel-btn" onclick="exportAuditToExcel()"
            style="display:none;" class="btn-excel" title="Descargar Excel">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
           fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
        <polyline points="14 2 14 8 20 8"/>
        <line x1="8" y1="13" x2="16" y2="13"/>
        <line x1="8" y1="17" x2="16" y2="17"/>
        <line x1="10" y1="9" x2="8" y2="9"/>
      </svg>
      Exportar Excel
    </button>
  </div>
  <div class="table-wrapper" id="audit-table-wrapper" style="flex: 1; min-height: 0;">
    <table class="data-table" id="audit-table">
      <thead>
        <tr>
          <th style="width: 140px;">Fecha y Hora</th>
          <th style="width: 140px;">Usuario</th>
          <th style="width: 55px;" class="text-center">Cant.</th>
          <th style="width: 100px;" class="text-right">Total Com.</th>
          <th style="width: 200px;">Comprobantes</th>
          <th style="width: 200px;">Comisiones</th>
          <th style="width: 200px;">Vendedores</th>
          <th style="width: 110px;">Tipo</th>
          <th class="audit-sel-col text-center" style="width:44px; display:none;"></th>
        </tr>
      </thead>
      <tbody id="audit-tbody">
        <% if (audit_history[:records] || []).empty? %>
          <tr>
            <td colspan="8" class="text-center" style="padding: 40px; color: var(--text-muted);">
              No hay registros de auditoría disponibles.
            </td>
          </tr>
        <% else %>
          <% (audit_history[:records] || []).each do |audit| %>
          <%
            raw_fecha = audit[:fecha_hora] || audit["fecha_hora"]
            fecha_fmt = begin
              Time.parse(raw_fecha.to_s).strftime("%d/%m/%Y %H:%M:%S")
            rescue
              raw_fecha
            end
          %>
            <tr>
              <td><%= fecha_fmt %></td>
              <td>
                <span style="font-weight: 600; color: var(--accent-cyan);">
                  <%= audit[:usuario] || audit["usuario"] %>
                </span>
              </td>
              <td class="text-center">
                <span class="status-badge" style="background: rgba(0, 212, 255, 0.1); color: var(--accent-cyan); border: 1px solid rgba(0, 212, 255, 0.2);">
                  <%= audit[:cant_fact] || audit["cant_fact"] %>
                </span>
              </td>
              <%
                total_val = (audit[:total_comision] || audit["total_comision"]).to_f
                total_color = total_val < 0 ? '#ef4444' : 'var(--accent-green)'
              %>
              <td class="text-right" style="font-weight: 600; color: <%= total_color %>">
                S/ <%= number_with_precision(total_val, precision: 2, separator: '.', delimiter: ',') %>
              </td>
              <td style="font-size: 0.8rem; color: var(--text-secondary); width:200px; white-space: normal; word-break: break-word; vertical-align: top;"
                  title="<%= audit[:comprobantes] || audit["comprobantes"] %>">
                <%= audit[:comprobantes] || audit["comprobantes"] %>
              </td>
              <td style="font-size: 0.8rem; color: var(--text-secondary); width:200px; white-space: normal; word-break: break-word; vertical-align: top;"
                  title="<%= audit[:comisiones] || audit["comisiones"] %>">
                <%= audit[:comisiones] || audit["comisiones"] %>
              </td>
              <td style="font-size: 0.8rem; color: var(--text-secondary); width:200px; white-space: normal; word-break: break-word; vertical-align: top;"
                  title="<%= audit[:vendedores] || audit["vendedores"] %>">
                <%= audit[:vendedores] || audit["vendedores"] %>
              </td>
              <td style="font-size: 0.8rem; color: var(--text-muted);">
                <%= audit[:tipo_comision] || audit["tipo_comision"] %>
              </td>
              <td class="audit-sel-col text-center" style="display:none;">
                <input type="checkbox" class="audit-check"
                       data-comps="<%= audit[:comprobantes] || audit["comprobantes"] %>"
                       data-comis="<%= audit[:comisiones] || audit["comisiones"] %>"
                       data-vends="<%= audit[:vendedores] || audit["vendedores"] %>"
                       data-total="<%= total_val %>"
                       data-cant="<%= audit[:cant_fact] || audit["cant_fact"] %>"
                       data-fecha="<%= fecha_fmt %>"
                       data-usuario="<%= audit[:usuario] || audit["usuario"] %>">
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
    <div id="audit-loading" style="display:none; text-align:center; padding:16px; color:var(--text-muted);">
      Cargando más registros...
    </div>
    <div id="audit-end" style="display:none; text-align:center; padding:16px; color:var(--text-muted); font-size:0.8rem;">
      ✓ No hay más registros
    </div>
  </div>
</div>

<script>
// ---- Toggle selección para exportar ----
var _auditSelectMode = false;
function toggleAuditSelection() {
  _auditSelectMode = !_auditSelectMode;
  var cols = document.querySelectorAll('.audit-sel-col');
  var btn  = document.getElementById('audit-excel-btn');
  var icon = document.getElementById('audit-select-icon');
  cols.forEach(function(c) { c.style.display = _auditSelectMode ? 'table-cell' : 'none'; });
  btn.style.display = _auditSelectMode ? 'flex' : 'none';
  if (_auditSelectMode) {
    icon.innerHTML = '<polyline points="20 6 9 17 4 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>';
    document.getElementById('audit-select-btn').title = 'Finalizar selección';
  } else {
    icon.innerHTML = '<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>';
    document.getElementById('audit-select-btn').title = 'Seleccionar filas para exportar';
  }
}

function exportAuditToExcel() {
  var checks = document.querySelectorAll('.audit-check');
  var selected = Array.from(checks).filter(function(c) { return c.checked; });
  var sourceChecks = selected.length > 0 ? selected : Array.from(checks);

  var data = [['Fecha y Hora', 'Comprobantes', 'Comisión (S/)', 'Vendedor', 'Usuario']];

  sourceChecks.forEach(function(cb, idx) {
    var fecha   = cb.dataset.fecha   || '';
    var usuario = cb.dataset.usuario || '';
    var total   = parseFloat(cb.dataset.total || 0);
    var cant    = cb.dataset.cant    || '';
    var comps  = (cb.dataset.comps  || '').split(',').map(function(s){ return s.trim(); });
    var comis  = (cb.dataset.comis  || '').split(',').map(function(s){ return s.trim(); });
    var vends  = (cb.dataset.vends  || '').split(',').map(function(s){ return s.trim(); });
    var n = Math.max(comps.length, comis.length, vends.length);
    for (var i = 0; i < n; i++) {
      data.push([fecha, comps[i]||'', 'S/ '+(comis[i]||''), vends[i]||'', usuario]);
    }
    // Fila de resumen
    data.push(['', 'Total Comisión (S/)', 'S/ '+total.toFixed(2), 'Cant. Fact', cant]);
    // Fila en blanco entre registros (excepto el último)
    if (idx < sourceChecks.length - 1) data.push([]);
  });

  var wb = XLSX.utils.book_new();
  var ws = XLSX.utils.aoa_to_sheet(data);
  XLSX.utils.book_append_sheet(wb, ws, 'Historial');
  XLSX.writeFile(wb, 'historial_auditoria.xlsx');
}

(function() {
  // Estado de paginación del Historial
  var auditPage = 1;
  var auditHasMore = <%= (audit_history[:has_more] ? 'true' : 'false') %>;
  var auditLoading = false;
  var auditComprobantes = '';
  var auditUsuario = '';
  var wrapper = document.getElementById('audit-table-wrapper');
  var tbody = document.getElementById('audit-tbody');
  var loadingEl = document.getElementById('audit-loading');
  var endEl = document.getElementById('audit-end');

  // Mostrar u ocultar indicador de "sin más páginas"
  if (!auditHasMore) {
    endEl.style.display = 'block';
  }

  function getBasePath() {
    return window.location.pathname.includes('/app_comisiones') ? '/app_comisiones/' : '/';
  }

  function buildUrl(page) {
    var url = getBasePath() + 'historial_data?page=' + page;
    if (auditComprobantes) url += '&comprobantes_filter=' + encodeURIComponent(auditComprobantes);
    if (auditUsuario)      url += '&usuario_filter='      + encodeURIComponent(auditUsuario);
    return url;
  }

  function renderRow(audit) {
    var rawFecha = audit.fecha_hora || '';
    var fecha = rawFecha;
    try {
      var d = new Date(rawFecha);
      if (!isNaN(d.getTime())) {
        var dd = String(d.getDate()).padStart(2,'0');
        var mm = String(d.getMonth()+1).padStart(2,'0');
        var yyyy = d.getFullYear();
        var hh = String(d.getHours()).padStart(2,'0');
        var min = String(d.getMinutes()).padStart(2,'0');
        var ss = String(d.getSeconds()).padStart(2,'0');
        fecha = dd+'/'+mm+'/'+yyyy+' '+hh+':'+min+':'+ss;
      }
    } catch(e) {}
    var usuario = audit.usuario || '';
    var cant = audit.cant_fact || '';
    var totalVal = parseFloat(audit.total_comision || 0);
    var totalColor = totalVal < 0 ? '#ef4444' : 'var(--accent-green)';
    var total = totalVal.toFixed(2);
    var comps  = audit.comprobantes   || '';
    var comiss = audit.comisiones     || '';
    var vends  = audit.vendedores     || '';
    var tipo   = audit.tipo_comision  || '';
    var displayStyle = _auditSelectMode ? 'table-cell' : 'none';
    return '<tr>' +
      '<td>' + fecha + '</td>' +
      '<td><span style="font-weight:600;color:var(--accent-cyan);">' + usuario + '</span></td>' +
      '<td class="text-center"><span class="status-badge" style="background:rgba(0,212,255,0.1);color:var(--accent-cyan);border:1px solid rgba(0,212,255,0.2);">' + cant + '</span></td>' +
      '<td class="text-right" style="font-weight:600;color:' + totalColor + ';">S/ ' + total + '</td>' +
      '<td style="font-size:0.8rem;color:var(--text-secondary);width:200px;white-space:normal;word-break:break-word;vertical-align:top;" title="' + comps + '">' + comps + '</td>' +
      '<td style="font-size:0.8rem;color:var(--text-secondary);width:200px;white-space:normal;word-break:break-word;vertical-align:top;" title="' + comiss + '">' + comiss + '</td>' +
      '<td style="font-size:0.8rem;color:var(--text-secondary);width:200px;white-space:normal;word-break:break-word;vertical-align:top;" title="' + vends + '">' + vends + '</td>' +
      '<td style="font-size:0.8rem;color:var(--text-muted);">' + tipo + '</td>' +
      '<td class="audit-sel-col text-center" style="display:' + displayStyle + ';">' +
        '<input type="checkbox" class="audit-check"' +
        ' data-comps="' + comps + '" data-comis="' + comiss + '" data-vends="' + vends + '"' +
        ' data-total="' + totalVal + '" data-cant="' + cant + '"' +
        ' data-fecha="' + fecha + '" data-usuario="' + usuario + '"></td>' +
      '</tr>';
  }

  function loadNextPage() {
    if (auditLoading || !auditHasMore) return;
    auditLoading = true;
    auditPage += 1;
    loadingEl.style.display = 'block';

    fetch(buildUrl(auditPage), {
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      loadingEl.style.display = 'none';
      auditLoading = false;

      if (data.error) {
        tbody.insertAdjacentHTML('beforeend',
          '<tr><td colspan="8" class="text-center" style="color:var(--accent-orange);">' + data.error + '</td></tr>');
        return;
      }

      var records = data.records || [];
      auditHasMore = data.has_more;

      records.forEach(function(audit) {
        tbody.insertAdjacentHTML('beforeend', renderRow(audit));
      });

      if (!auditHasMore) {
        endEl.style.display = 'block';
      }
    })
    .catch(function(err) {
      loadingEl.style.display = 'none';
      auditLoading = false;
      console.error('Error cargando historial:', err);
    });
  }

  // Recargar tabla desde cero con nuevos filtros
  function reloadWithFilters(comprobantes, usuario) {
    auditComprobantes = comprobantes || '';
    auditUsuario = usuario || '';
    auditPage = 1;
    auditHasMore = true;
    auditLoading = false;
    tbody.innerHTML = '<tr><td colspan="8" class="text-center" style="padding:20px;color:var(--text-muted);">Buscando...</td></tr>';
    endEl.style.display = 'none';

    fetch(buildUrl(1), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      auditHasMore = data.has_more;
      var records = data.records || [];
      tbody.innerHTML = '';
      if (records.length === 0) {
        tbody.innerHTML = '<tr><td colspan="8" class="text-center" style="padding:40px;color:var(--text-muted);">Sin resultados</td></tr>';
      } else {
        records.forEach(function(a) { tbody.insertAdjacentHTML('beforeend', renderRow(a)); });
      }
      endEl.style.display = auditHasMore ? 'none' : 'block';
    })
    .catch(function(err) { console.error('Error al recargar filtros:', err); });
  }

  // Escuchar evento de filtros desde index.html.erb
  function handleFilterEvent(e) {
    reloadWithFilters(e.detail.comprobantes, e.detail.usuario);
  }
  document.removeEventListener('historial:filter', handleFilterEvent);
  document.addEventListener('historial:filter', handleFilterEvent);

  // Detectar scroll al fondo de la tabla
  if (wrapper) {
    wrapper.addEventListener('scroll', function() {
      var threshold = 80;
      if (wrapper.scrollTop + wrapper.clientHeight >= wrapper.scrollHeight - threshold) {
        loadNextPage();
      }
    });
  }
})();
</script>
