<!-- Panel Tab: Resumen por Comprobante -->
<div class="table-section">
  <div class="table-header">
    <h3>Resumen de Facturas</h3>
    <p>Detalle de comprobantes - mostrando <%= details.count %> registros</p>
  </div>
  <div class="table-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th>Nro. Factura</th>
          <th>Cliente</th>
          <th>Vendedor</th>
          <th>Fecha</th>
          <th class="text-right">Monto (S/)</th>
          <th class="text-right">Cobrado (S/)</th>
          <th class="text-right">Saldo (S/)</th>
          <th class="text-center">Estado</th>
        </tr>
      </thead>
      <tbody>
        <% (details || []).each do |detail| %>
          <tr>
            <td><%= detail["nro_fact"] || "-" %></td>
            <td><%= (detail["nombre_cliente"] || "-").truncate(35) %></td>
            <td><%= (detail["vendedor"] || "-").truncate(30) %></td>
            <td><%= detail["fecha_emision"].to_s[0..9] rescue "-" %></td>
            <td class="text-right">S/ <%= number_with_delimiter(detail["monto_soles"].to_f.round(2), delimiter: '.', separator: ',') rescue '0,00' %></td>
            <td class="text-right">S/ <%= number_with_delimiter(detail["cobrado"].to_f.round(2), delimiter: '.', separator: ',') rescue '0,00' %></td>
            <td class="text-right">S/ <%= number_with_delimiter(detail["saldo"].to_f.round(2), delimiter: '.', separator: ',') rescue '0,00' %></td>
            <td class="text-center">
              <span class="status-badge <%= detail['cancelado'] == 'S' ? 'status-paid' : 'status-pending' %>">
                <%= detail["cancelado"] == "S" ? "PAGADO" : "PENDIENTE" %>
              </span>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="4"><strong>Total</strong></td>
          <td class="text-right"><strong>S/ <%= number_with_delimiter(dashboard[:total_monto].round(2), delimiter: '.', separator: ',') rescue '0,00' %></strong></td>
          <td class="text-right"><strong>S/ <%= number_with_delimiter(dashboard[:total_cobrado].round(2), delimiter: '.', separator: ',') rescue '0,00' %></strong></td>
          <td class="text-right"><strong>S/ <%= number_with_delimiter(dashboard[:total_saldo].round(2), delimiter: '.', separator: ',') rescue '0,00' %></strong></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>
