<!-- Productos Tab: Resumen de Ventas con Comisión por Producto -->
<div class="table-section">
<% if @selected_vendors.empty? %>
  <div style="display:flex; flex-direction:column; align-items:center; justify-content:center; padding:60px 20px; color:var(--text-muted); text-align:center;">
    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom:16px; opacity:0.4;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <h3 style="margin-bottom:8px; font-size:1.1rem;">Sin vendedor seleccionado</h3>
    <p style="font-size:0.875rem;">Selecciona <strong>Todas</strong> o un vendedor específico en el filtro para ver el detalle de productos.</p>
  </div>
<% else %>
  <%
    # Pre-calcular totales para tooltips
    items = (details || [])
    clase_totals = items.group_by { |i| i[:clase] }.transform_values do |grouped_items|
      grouped_items.sum { |i| i[:comision_soles].to_f }
    end
    # También calculamos tipo_cliente para esta pestaña por consistencia
    tipo_cliente_totals = items.group_by { |i| i[:tipo_cliente] }.transform_values do |grouped_items|
      grouped_items.sum { |i| i[:comision_soles].to_f }
    end
  %>
  <div class="table-header" style="display: flex; justify-content: space-between; align-items: center;">
    <div>
      <div style="display: flex; align-items: center; gap: 10px;">
        <h3>Resumen de Ventas por Producto</h3>
        <button data-action="click->dashboard#toggleCommissionEdit" class="btn-icon" title="Editar Comisiones" data-dashboard-target="editIcon" style="background: none; border: none; color: var(--accent-cyan); cursor: pointer; display: flex; align-items: center; padding: 5px;">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-edit"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        </button>
      </div>
      <p>Detalle de comprobantes con comisión por SKU seleccionados</p>
    </div>
    <button data-action="click->dashboard#exportToExcel" class="btn-excel" title="Descargar Excel">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
      Exportar Excel
    </button>
  </div>
  <div class="table-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th style="width: 85px;">Cliente</th>
          <th style="width: 85px;">Fecha</th>
          <th style="width: 120px;">Factura</th>
          <th class="text-center" style="width: 55px;">Can.</th>
          <th class="text-center" style="width: 55px;" title="Comisión Pagada">Pag.</th>
          <th class="text-center" style="width: 55px;">Clase</th>
          <th>Producto</th>
          <th class="text-right" style="width: 135px;">Precio (S/)</th>
          <th class="text-left" style="width: 140px;">Vendedor</th>
          <th class="text-left" style="width: 160px; display:none;">Nombre Cliente</th>
          <th class="text-right" style="width: 135px;">Comisión (S/)</th>
          <th class="text-right" style="width: 110px; display: none; padding-right: 16px;" data-dashboard-target="commissionColumn">
            <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
              <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase;">Pagada</span>
              <input type="checkbox" data-action="change->dashboard#toggleSelectAll" data-dashboard-target="selectAllCheckbox">
            </div>
          </th>
        </tr>
      </thead>
      <tbody>
        <% (details || []).each do |item| %>
          <tr>
            <% 
              tipo = item[:tipo_cliente].to_s
              total_tipo = tipo_cliente_totals[tipo] || 0
              tooltip_tipo = "TIPO CLIENTE: #{tipo} | Total = S/. #{number_with_precision(total_tipo, precision: 2, separator: '.', delimiter: ',')}"
            %>
            <td title="<%= tooltip_tipo %>"><span><%= tipo %></span></td>
            <td><%= item[:fecha_emision] %></td>
            <td><%= item[:numero_factura] %></td>
            <td class="text-center">
              <% if item[:cancelado] == "S" %>
                <span class="status-badge status-paid" title="Cancelado">S</span>
              <% else %>
                <span class="status-badge status-pending" title="Pendiente">N</span>
              <% end %>
            </td>
            <td class="text-center">
              <% if item[:comision_pagada] %>
                <span class="status-badge status-paid" title="Pagada">SI</span>
              <% else %>
                <span class="status-badge status-pending" title="No Pagada">NO</span>
              <% end %>
            </td>
              <% 
                clase = item[:clase].to_s.upcase
                total_clase = clase_totals[item[:clase]] || 0
                tooltip_clase = "CLASE #{clase}: Total = S/. #{number_with_precision(total_clase, precision: 2, separator: '.', delimiter: ',')}"
              %>
              <td class="text-center" title="<%= tooltip_clase %>">
                <% if item[:clase].present? %>
                  <span class="status-badge clase-<%= item[:clase].downcase %>"><%= item[:clase] %></span>
                <% else %>
                  -
                <% end %>
              </td>
            <td data-product-code="<%= item[:producto_codigo] %>"
                style="min-width: 200px; max-width: 260px; white-space: normal; word-break: break-word; vertical-align: top;">
              <span class="product-name" title="<%= item[:producto_codigo] %>" style="display:block;">
                <%= item[:producto_codigo] %>
              </span>
            </td>
            <td class="text-right" style="white-space: nowrap; font-weight: 600; font-variant-numeric: tabular-nums;">
              S/ <%= number_with_precision(item[:precio_soles].to_f, precision: 2, separator: '.', delimiter: ',') %>
            </td>
            <td class="text-left">
              <%= item[:vendedor] %>
            </td>
            <td class="text-left" style="display:none;">
              <%= item[:nombre_cliente] %>
            </td>
            <td class="text-right" style="white-space: nowrap; font-variant-numeric: tabular-nums;">
              <strong style="color: var(--accent-cyan);">S/ <%= number_with_precision(item[:comision_soles].to_f, precision: 2, separator: '.', delimiter: ',') %></strong>
            </td>
            <td class="text-center" 
                style="display: none; vertical-align: middle; <%= 'background: rgba(0,0,0,0.2);' if item[:cancelado] != 'S' && item[:tipo_cliente].to_s.include?('PUBLICO') %>" 
                data-dashboard-target="commissionColumn">
              <input type="checkbox" 
                     class="commission-checkbox" 
                     data-dashboard-target="itemCheckbox"
                     data-url="<%= item[:invoice_url] %>" 
                     data-invoice-number="<%= item[:numero_factura] %>"
                     data-commission-amount="<%= item[:comision_soles] %>"
                     data-vendor="<%= item[:vendedor] %>"
                     data-action="change->dashboard#onItemCheckboxChange"
                     <%= 'checked' if item[:comision_pagada] %>
                     <%= 'disabled' if item[:cancelado] != 'S' && item[:tipo_cliente].to_s.include?('PUBLICO') %>
                     style="<%= 'opacity: 0.4; cursor: not-allowed;' if item[:cancelado] != 'S' && item[:tipo_cliente].to_s.include?('PUBLICO') %>"
                     title="<%= 'Solo se puede pagar si la factura está cancelada (CAN=S)' if item[:cancelado] != 'S' && item[:tipo_cliente].to_s.include?('PUBLICO') %>">
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="7"><strong>Total Periodos (<%= @selected_months.join(', ') %>)</strong></td>
          <td class="text-right" style="white-space: nowrap;">
            <strong>S/ <%= number_with_precision((details || []).sum { |i| i[:precio_soles].to_f }, precision: 2, separator: '.', delimiter: ',') %></strong>
          </td>
          <td></td>
          <td class="text-right" style="white-space: nowrap;">
            <strong style="color: var(--accent-cyan); font-size: 1.1rem;">S/ <%= number_with_precision((details || []).sum { |i| i[:comision_soles].to_f }, precision: 2, separator: '.', delimiter: ',') %></strong>
          </td>
          <td data-dashboard-target="commissionColumn" style="display: none;"></td>
        </tr>
      </tfoot>
    </table>
  </div>
<% end %>
</div>
