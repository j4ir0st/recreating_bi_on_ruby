<!-- Tab de Vendedor: Resumen o Detalle -->
<div class="table-section">
  <% if @selected_vendors.any? %>
    <!-- VISTA DETALLADA: Items por Factura para el Vendedor Seleccionado -->
    <div class="table-header" style="display: flex; justify-content: space-between; align-items: center;">
      <div>
      <div style="display: flex; align-items: center; gap: 10px;">
        <h3>Detalle de Ventas - <%= @selected_vendors.length > 3 ? "#{@selected_vendors.length} Vendedores" : @selected_vendors.join(', ') %></h3>
        <button data-action="click->dashboard#toggleCommissionEdit" class="btn-icon" title="Editar Comisiones" data-dashboard-target="editIcon" style="background: none; border: none; color: var(--accent-cyan); cursor: pointer; display: flex; align-items: center; padding: 5px;">
          <!-- Icono de Editar (Lápiz) por defecto -->
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-edit"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        </button>
      </div>
      <p>Desglose por producto y factura</p>
    </div>
    <button data-action="click->dashboard#exportToExcel" class="btn-excel" title="Descargar Excel">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
      Exportar Excel
    </button>
  </div>
  <div class="table-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th style="width: 85px;">Cliente</th>
          <th style="width: 85px; cursor:pointer; user-select:none; white-space:nowrap;" id="vendedor-fecha-th" onclick="toggleVendedorDateSort()">
            Fecha <span id="vendedor-sort-icon" style="font-size:0.7rem; color:var(--accent-cyan);">&#9660;</span>
          </th>
          <th style="width: 120px;">N° Factura</th>
          <th style="width: 55px;" class="text-center">Can.</th>
          <th style="width: 55px;" class="text-center" title="Comisión Pagada">Pag.</th>
          <th>Producto</th>
          <th class="text-right" style="width: 135px;">Precio (S/)</th>
          <th class="text-left" style="width: 140px;">Vendedor</th>
          <th class="text-left" style="width: 160px; display:none;">Nombre Cliente</th>
          <th class="text-right" style="width: 135px;">Comisión (S/)</th>
          <th class="text-center" style="width: 100px; display: none;" data-dashboard-target="commissionColumn">
            Pagada<br>
            <input type="checkbox" data-action="change->dashboard#toggleSelectAll" data-dashboard-target="selectAllCheckbox">
          </th>
        </tr>
      </thead>
        <tbody>
          <% (@vendor_details || []).each do |item| %>
            <tr data-date="<%= item[:fecha_emision] %>">
              <td><span title="<%= item[:tipo_cliente] %>"><%= item[:tipo_cliente] %></span></td>
              <td><%= item[:fecha_emision] %></td>
              <td><%= item[:numero_factura] %></td>
              <td class="text-center">
                <% if item[:cancelado] == "S" %>
                  <span class="status-badge status-paid" title="Cancelado">S</span>
                <% else %>
                  <span class="status-badge status-pending" title="Pendiente">N</span>
                <% end %>
              </td>
              <td class="text-center">
                <% if item[:comision_pagada] %>
                  <span class="status-badge status-paid" title="Pagada">SI</span>
                <% else %>
                  <span class="status-badge status-pending" title="No Pagada">NO</span>
                <% end %>
              </td>
              <td data-product-code="<%= item[:producto_codigo] %>"
                  style="min-width: 180px; max-width: 220px; white-space: normal; word-break: break-word; vertical-align: top;">
                <span class="product-name" title="<%= item[:producto_codigo] %>" style="display:block;">
                  <%= item[:producto_codigo] %>
                </span>
              </td>
              <td class="text-right" style="white-space: nowrap; font-weight: 600;">
                S/ <%= number_with_precision(item[:precio_soles].to_f, precision: 2, separator: '.', delimiter: ',') %>
              </td>
              <td class="text-left">
                <%= item[:vendedor] %>
              </td>
              <td class="text-left" style="display:none;">
                <%= item[:nombre_cliente] %>
              </td>
              <td class="text-right" style="white-space: nowrap;">
                <strong style="color: var(--accent-cyan);">S/ <%= number_with_precision(item[:comision_soles].to_f, precision: 2, separator: '.', delimiter: ',') %></strong>
              </td>
              <td class="text-center" style="display: none;" data-dashboard-target="commissionColumn">
                <input type="checkbox" 
                       class="commission-checkbox" 
                       data-dashboard-target="itemCheckbox"
                       data-url="<%= item[:invoice_url] %>" 
                       data-invoice-number="<%= item[:numero_factura] %>"
                       data-commission-amount="<%= item[:comision_soles] %>"
                       data-vendor="<%= item[:vendedor] %>"
                       data-action="change->dashboard#onItemCheckboxChange"
                       <%= 'checked' if item[:comision_pagada] %>>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="6"><strong>Total Periodos (<%= @selected_months.join(', ') %>)</strong></td>
            <td class="text-right" style="white-space: nowrap;">
              <strong>S/ <%= number_with_precision((@vendor_details || []).sum { |i| i[:precio_soles].to_f }, precision: 2, separator: '.', delimiter: ',') %></strong>
            </td>
            <td></td>
            <td class="text-right" style="white-space: nowrap;">
              <strong style="color: var(--accent-cyan); font-size: 1.1rem;">S/ <%= number_with_precision((@vendor_details || []).sum { |i| i[:comision_soles].to_f }, precision: 2, separator: '.', delimiter: ',') %></strong>
            </td>
            <td data-dashboard-target="commissionColumn" style="display: none;"></td>
          </tr>
        </tfoot>
      </table>
    </div>

  <% else %>
    <!-- VISTA RESUMEN: Lista de Vendedores -->
    <div class="table-header" style="display: flex; justify-content: space-between; align-items: center;">
      <div>
        <h3>Resumen por Vendedor</h3>
        <p>Montos agrupados por vendedor</p>
      </div>
      <button data-action="click->dashboard#exportToExcel" class="btn-excel" title="Descargar Excel">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
        Exportar Excel
      </button>
    </div>
    <div class="table-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th style="min-width: 140px;">Vendedor</th>
            <th class="text-right">Monto Total (S/)</th>
            <th class="text-right">Cobrado (S/)</th>
            <th class="text-right">Saldo (S/)</th>
            <th class="text-center">Comprobantes</th>
          </tr>
        </thead>
        <tbody>
          <% (@vendor_data || []).each do |vd| %>
            <tr>
              <td><%= vd[:vendedor] %></td>
              <td class="text-right">S/ <%= number_with_delimiter(vd[:monto_soles].round(2), delimiter: '.', separator: ',') rescue '0,00' %></td>
              <td class="text-right">S/ <%= number_with_delimiter(vd[:cobrado].round(2), delimiter: '.', separator: ',') rescue '0,00' %></td>
              <td class="text-right">S/ <%= number_with_delimiter(vd[:saldo].round(2), delimiter: '.', separator: ',') rescue '0,00' %></td>
              <td class="text-center"><%= vd[:count] %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <td><strong>Total</strong></td>
            <td class="text-right"><strong>S/ <%= number_with_delimiter(dashboard[:total_monto].round(2), delimiter: '.', separator: ',') rescue '0,00' %></strong></td>
            <td class="text-right"><strong>S/ <%= number_with_delimiter(dashboard[:total_cobrado].round(2), delimiter: '.', separator: ',') rescue '0,00' %></strong></td>
            <td class="text-right"><strong>S/ <%= number_with_delimiter(dashboard[:total_saldo].round(2), delimiter: '.', separator: ',') rescue '0,00' %></strong></td>
            <td class="text-center"><strong><%= dashboard[:total_comprobantes] %></strong></td>
          </tr>
        </tfoot>
      </table>
    </div>
  <% end %>
</div>
<script>
(function(){
  var _vendedorDesc = true;
  function sortVendedorRows(desc) {
    var tbody = document.querySelector('#vendedor-detail-table tbody');
    if (!tbody) { tbody = document.querySelector('.data-table tbody'); }
    if (!tbody) return;
    var rows = Array.from(tbody.querySelectorAll('tr[data-date]'));
    rows.sort(function(a, b){
      var da = a.dataset.date || '', db = b.dataset.date || '';
      return desc ? db.localeCompare(da) : da.localeCompare(db);
    });
    rows.forEach(function(r){ tbody.appendChild(r); });
    var icon = document.getElementById('vendedor-sort-icon');
    if (icon) icon.innerHTML = desc ? '&#9660;' : '&#9650;';
  }
  window.toggleVendedorDateSort = function(){
    _vendedorDesc = !_vendedorDesc;
    sortVendedorRows(_vendedorDesc);
  };
  // Ordenar al cargar: más reciente primero
  sortVendedorRows(true);
})();
</script>
