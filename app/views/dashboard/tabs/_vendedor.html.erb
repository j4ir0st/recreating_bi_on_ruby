<style>
  .filter-dropdown {
    display: inline-flex;
    align-items: center;
  }
  .filter-dropdown-content {
    display: none;
    position: absolute;
    background-color: #1e1e1e;
    min-width: 130px;
    box-shadow: 0px 8px 24px 0px rgba(0,0,0,0.8);
    z-index: 9999;
    border: 1px solid #444;
    border-radius: 6px;
    padding: 6px 0;
    left: 0;
    top: calc(100% + 5px);
  }
  .filter-dropdown-content a {
    color: #e0e0e0;
    padding: 10px 16px;
    text-decoration: none;
    display: block;
    font-size: 0.8rem;
    font-weight: 500;
    transition: all 0.2s;
    text-align: left;
    border-bottom: 1px solid #333;
  }
  .filter-dropdown-content a:last-child {
    border-bottom: none;
  }
  .filter-dropdown-content a:hover {
    background-color: var(--accent-cyan);
    color: #000;
  }
  .filter-dropdown.active .filter-dropdown-content {
    display: block;
  }
  .filter-icon {
    cursor: pointer;
    color: var(--accent-cyan);
    font-size: 0.75rem;
    padding: 4px;
    transition: transform 0.2s;
    display: flex;
    align-items: center;
  }
  .filter-icon:hover {
    transform: scale(1.2);
  }
  .filter-current-label {
    font-size: 0.65rem;
    color: var(--accent-cyan);
    font-weight: 700;
    text-transform: uppercase;
    display: block;
    margin-top: -2px;
    letter-spacing: 0.5px;
  }
  .filter-dropdown-content a {
    color: #e0e0e0;
    padding: 10px 16px;
    text-decoration: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    font-weight: 500;
    transition: all 0.2s;
    text-align: left;
    border-bottom: 1px solid #333;
  }
  .filter-check {
    color: var(--accent-cyan);
    font-weight: bold;
    visibility: hidden;
  }
  .filter-check.active {
    visibility: visible;
  }
</style>

<!-- Tab de Vendedor: Resumen o Detalle -->
<div class="table-section">
  <% if @selected_vendors.any? %>
    <%
      # Pre-calcular totales por tipo de cliente y clase para los tooltips
      items = (@vendor_details || [])
      tipo_cliente_totals = items.group_by { |i| i[:tipo_cliente] }.transform_values do |grouped_items|
        grouped_items.sum { |i| i[:comision_soles].to_f }
      end
      clase_totals = items.group_by { |i| i[:clase] }.transform_values do |grouped_items|
        grouped_items.sum { |i| i[:comision_soles].to_f }
      end
    %>
  <!-- VISTA DETALLADA: Items por Factura para el Vendedor Seleccionado -->
  <div class="table-header" style="display: flex; justify-content: space-between; align-items: center;padding: 4px 12px; margin: 0px">
    <div>
      <div style="display: flex; align-items: center; gap: 2px;">
        <h3>Detalle de Ventas - <%= @selected_vendors.length > 3 ? "#{@selected_vendors.length} Vendedores" : @selected_vendors.join(', ') %></h3>
        <button data-action="click->dashboard#toggleCommissionEdit" class="btn-icon" title="Editar Comisiones" data-dashboard-target="editIcon" style="background: none; border: none; color: var(--accent-cyan); cursor: pointer; display: flex; align-items: center; padding: 5px;">
          <!-- Icono de Editar (Lápiz) por defecto -->
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-edit"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        </button>
      </div>
      <p style="padding: 4px; margin: 0px">Desglose por producto y factura</p>
    </div>
    <button data-action="click->dashboard#exportToExcel" class="btn-excel" title="Descargar Excel">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
      Exportar Excel
    </button>
  </div>
  <div class="table-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th style="width: 110px; position: sticky; top: 0; z-index: 20; white-space: nowrap; background: var(--bg-table-header);">
            <div style="display: flex; align-items: flex-start; justify-content: space-between; width: 100%;">
              <div style="display: flex; flex-direction: column;">
                <span style="text-transform: uppercase; font-size: 0.8rem; font-weight: 600; color: var(--text-secondary);">Cliente</span>
                <span class="filter-current-label" id="current-cliente-filter">TODOS</span>
              </div>
              <div class="filter-dropdown" id="cliente-filter-dropdown">
                <span class="filter-icon" onclick="toggleClienteFilter(event)">&#9660;</span>
                <div class="filter-dropdown-content">
                  <a href="#" onclick="filtrarPorCliente('TODOS', event)" data-filter-val="TODOS">
                    TODOS <span class="filter-check active">&#10003;</span>
                  </a>
                  <a href="#" onclick="filtrarPorCliente('PRIVADO', event)" data-filter-val="PRIVADO">
                    PRIVADO <span class="filter-check">&#10003;</span>
                  </a>
                  <a href="#" onclick="filtrarPorCliente('PUBLICO', event)" data-filter-val="PUBLICO">
                    PUBLICO <span class="filter-check">&#10003;</span>
                  </a>
                </div>
              </div>
            </div>
          </th>
          <th style="width: 85px; cursor:pointer; user-select:none; white-space:nowrap;" id="vendedor-fecha-th" onclick="toggleVendedorDateSort()">
            Fecha <span id="vendedor-sort-icon" style="font-size:0.7rem; color:var(--accent-cyan);">&#9660;</span>
          </th>
          <th style="width: 120px;">N° Factura</th>
          <th style="width: 55px;" class="text-center">Can.</th>
          <th style="width: 55px;" class="text-center" title="Comisión Pagada">Pag.</th>
          <th style="width: 55px;" class="text-center">Clase</th>
          <th>Producto</th>
          <th class="text-right" style="width: 135px;">Precio (S/)</th>
          <th class="text-left col-vendedor" style="width: 140px; display: none;">Vendedor</th>
          <th class="text-left col-cliente" style="width: 160px;">Nombre Cliente</th>
          <th class="text-right" style="width: 135px;">Comisión (S/)</th>
          <th class="text-right" style="width: 110px; display: none; padding-right: 16px;" data-dashboard-target="commissionColumn">
            <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
              <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase;">Pagada</span>
              <input type="checkbox" data-action="change->dashboard#toggleSelectAll" data-dashboard-target="selectAllCheckbox">
            </div>
          </th>
        </tr>
      </thead>
        <tbody id="vendedor-items-body">
          <% (@vendor_details || []).each do |item| %>
            <tr data-date="<%= item[:fecha_emision] %>" data-tipo-cliente="<%= item[:tipo_cliente].to_s.upcase %>">
              <% 
                tipo = item[:tipo_cliente].to_s
                total_tipo = tipo_cliente_totals[tipo] || 0
                tooltip_tipo = "TIPO CLIENTE: #{tipo} | Total Comisiones = S/. #{number_with_precision(total_tipo, precision: 2, separator: '.', delimiter: ',')}"
              %>
              <td title="<%= tooltip_tipo %>"><span><%= tipo %></span></td>
              <td><%= item[:fecha_emision] %></td>
              <td><%= item[:numero_factura] %></td>
              <td class="text-center">
                <% if item[:cancelado] == "S" %>
                  <span class="status-badge status-paid" title="Cancelado">S</span>
                <% else %>
                  <span class="status-badge status-pending" title="Pendiente">N</span>
                <% end %>
              </td>
              <td class="text-center">
                <% if item[:comision_pagada] %>
                  <span class="status-badge status-paid" title="Pagada">SI</span>
                <% else %>
                  <span class="status-badge status-pending" title="No Pagada">NO</span>
                <% end %>
              </td>
              <% 
                clase_val = item[:clase].to_s.upcase
                total_clase = clase_totals[item[:clase]] || 0
                tooltip_clase = clase_val.present? ? "CLASE #{clase_val}: Total = S/. #{number_with_precision(total_clase, precision: 2, separator: '.', delimiter: ',')}" : ""
              %>
              <td class="text-center" title="<%= tooltip_clase %>">
                <% if item[:clase].present? %>
                  <span class="status-badge clase-<%= item[:clase].downcase %>"><%= item[:clase] %></span>
                <% else %>
                  -
                <% end %>
              </td>
              <td data-product-code="<%= item[:producto_codigo] %>"
                  style="min-width: 180px; max-width: 220px; white-space: normal; word-break: break-word; vertical-align: top;">
                <span class="product-name" title="<%= item[:producto_codigo] %>" style="display:block;">
                  <%= item[:producto_codigo] %>
                </span>
              </td>
              <td class="text-right row-precio" style="white-space: nowrap; font-weight: 600; font-variant-numeric: tabular-nums;">
                S/ <%= number_with_precision(item[:precio_soles].to_f, precision: 2, separator: '.', delimiter: ',') %>
              </td>
              <td class="text-left col-vendedor" style="display: none;">
                <%= item[:vendedor] %>
              </td>
              <td class="text-left col-cliente">
                <%= item[:nombre_cliente] %>
              </td>
              <td class="text-right row-comision" style="white-space: nowrap; font-variant-numeric: tabular-nums;">
                <strong style="color: var(--accent-cyan);">S/ <%= number_with_precision(item[:comision_soles].to_f, precision: 2, separator: '.', delimiter: ',') %></strong>
              </td>
              <td class="text-center" 
                  style="display: none; vertical-align: middle; <%= 'background: rgba(0,0,0,0.2);' if item[:cancelado] != 'S' && item[:tipo_cliente].to_s.include?('PUBLICO') %>" 
                  data-dashboard-target="commissionColumn">
                <input type="checkbox" 
                       class="commission-checkbox" 
                       data-dashboard-target="itemCheckbox"
                       data-url="<%= item[:invoice_url] %>" 
                       data-invoice-number="<%= item[:numero_factura] %>"
                       data-commission-amount="<%= item[:comision_soles] %>"
                       data-vendor="<%= item[:vendedor] %>"
                       data-action="change->dashboard#onItemCheckboxChange"
                       <%= 'checked' if item[:comision_pagada] %>
                       <%= 'disabled' if item[:cancelado] != 'S' && item[:tipo_cliente].to_s.include?('PUBLICO') %>
                       style="<%= 'opacity: 0.4; cursor: not-allowed;' if item[:cancelado] != 'S' && item[:tipo_cliente].to_s.include?('PUBLICO') %>"
                       title="<%= 'Solo se puede pagar si la factura está cancelada (CAN=S)' if item[:cancelado] != 'S' && item[:tipo_cliente].to_s.include?('PUBLICO') %>">
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="7">
              <strong>Total (Periodo: 
                <% if @start_date && @end_date %>
                  <%= @start_date.strftime("%d/%m/%Y") %> - <%= @end_date.strftime("%d/%m/%Y") %>
                <% else %>
                  Todos los años
                <% end %>
              )</strong>
            </td>
            <td class="text-right" style="white-space: nowrap;">
              <strong id="total-precio-footer">S/ <%= number_with_precision((@vendor_details || []).sum { |i| i[:precio_soles].to_f }, precision: 2, separator: '.', delimiter: ',') %></strong>
            </td>
            <td></td>
            <td class="text-right" style="white-space: nowrap;">
              <strong id="total-comision-footer" style="color: var(--accent-cyan); font-size: 1.1rem;">S/ <%= number_with_precision((@vendor_details || []).sum { |i| i[:comision_soles].to_f }, precision: 2, separator: '.', delimiter: ',') %></strong>
            </td>
            <td data-dashboard-target="commissionColumn" style="display: none;"></td>
          </tr>
        </tfoot>
      </table>
    </div>

  <% else %>
    <!-- VISTA RESUMEN: Lista de Vendedores -->
    <div class="table-header" style="display: flex; justify-content: space-between; align-items: center;">
      <div>
        <h3>Resumen por Vendedor</h3>
        <p>Montos agrupados por vendedor</p>
      </div>
      <button data-action="click->dashboard#exportToExcel" class="btn-excel" title="Descargar Excel">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
        Exportar Excel
      </button>
    </div>
    <div class="table-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th style="min-width: 140px;">Vendedor</th>
            <th class="text-right">Monto Total (S/)</th>
            <th class="text-right">Cobrado (S/)</th>
            <th class="text-right">Saldo (S/)</th>
            <th class="text-center">Comprobantes</th>
          </tr>
        </thead>
        <tbody>
          <% (@vendor_data || []).each do |vd| %>
            <tr>
              <td><%= vd[:vendedor] %></td>
              <td class="text-right">S/ <%= number_with_delimiter(vd[:monto_soles].round(2), delimiter: '.', separator: ',') rescue '0,00' %></td>
              <td class="text-right">S/ <%= number_with_delimiter(vd[:cobrado].round(2), delimiter: '.', separator: ',') rescue '0,00' %></td>
              <td class="text-right">S/ <%= number_with_delimiter(vd[:saldo].round(2), delimiter: '.', separator: ',') rescue '0,00' %></td>
              <td class="text-center"><%= vd[:count] %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <td><strong>Total</strong></td>
            <td class="text-right"><strong>S/ <%= number_with_delimiter(dashboard[:total_monto].round(2), delimiter: '.', separator: ',') rescue '0,00' %></strong></td>
            <td class="text-right"><strong>S/ <%= number_with_delimiter(dashboard[:total_cobrado].round(2), delimiter: '.', separator: ',') rescue '0,00' %></strong></td>
            <td class="text-right"><strong>S/ <%= number_with_delimiter(dashboard[:total_saldo].round(2), delimiter: '.', separator: ',') rescue '0,00' %></strong></td>
            <td class="text-center"><strong><%= dashboard[:total_comprobantes] %></strong></td>
          </tr>
        </tfoot>
      </table>
    </div>
  <% end %>
</div>

<% if @supervisor_rows.present? %>
  <div class="supervisor-integration" style="margin-top: -14px;">
    <%= render partial: "dashboard/tabs/supervisor", locals: { supervisor_rows: @supervisor_rows, integrated: true } %>
  </div>
<% end %>
<script>
(function(){
  var _ordenDescendenteVendedor = true;

  // Función para ordenar filas
  function ordenarFilasVendedor(descendente) {
    var tbody = document.getElementById('vendedor-items-body');
    if (!tbody) return;
    var rows = Array.from(tbody.querySelectorAll('tr[data-date]'));
    rows.sort(function(a, b){
      var fechaA = a.dataset.date || '', fechaB = b.dataset.date || '';
      return descendente ? fechaB.localeCompare(fechaA) : fechaA.localeCompare(fechaB);
    });
    rows.forEach(function(r){ tbody.appendChild(r); });
    var icono = document.getElementById('vendedor-sort-icon');
    if (icono) icono.innerHTML = descendente ? '&#9660;' : '&#9650;';
  }

  window.toggleVendedorDateSort = function(){
    _ordenDescendenteVendedor = !_ordenDescendenteVendedor;
    ordenarFilasVendedor(_ordenDescendenteVendedor);
  };

  // Función para mostrar/ocultar el dropdown de filtro
  window.toggleClienteFilter = function(e) {
    e.stopPropagation();
    document.getElementById('cliente-filter-dropdown').classList.toggle('active');
  };

  // Función para filtrar por tipo de cliente
  window.filtrarPorCliente = function(tipo, e) {
    if (e) e.preventDefault();
    document.getElementById('cliente-filter-dropdown').classList.remove('active');
    
    var tbody = document.getElementById('vendedor-items-body');
    if (!tbody) return;
    var rows = Array.from(tbody.querySelectorAll('tr'));
    
    rows.forEach(function(row) {
      var rowTipo = row.dataset.tipoCliente || '';
      if (tipo === 'TODOS' || rowTipo.includes(tipo)) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
    
    // Actualizar indicadores visuales
    var etiqueta = document.getElementById('current-cliente-filter');
    if (etiqueta) etiqueta.textContent = tipo;
    
    var checkboxes = document.querySelectorAll('#cliente-filter-dropdown .filter-check');
    checkboxes.forEach(function(check) {
      if (check.closest('a').dataset.filterVal === tipo) {
        check.classList.add('active');
      } else {
        check.classList.remove('active');
      }
    });

    recalcularTotalesVendedor();
  };

  // Función para recalcular totales basados en filas visibles
  function recalcularTotalesVendedor() {
    var tbody = document.getElementById('vendedor-items-body');
    if (!tbody) return;
    var filas = Array.from(tbody.querySelectorAll('tr')).filter(r => r.style.display !== 'none');
    
    var totalPrecio = 0;
    var totalComision = 0;

    rows.forEach(function(row) {
      var precioCell = row.querySelector('.row-precio');
      var comisionCell = row.querySelector('.row-comision');

      if (precioCell) {
        var p = precioCell.textContent.replace('S/ ', '').replace(/,/g, '').trim();
        totalPrecio += parseFloat(p) || 0;
      }
      if (comisionCell) {
        var c = comisionCell.textContent.replace('S/ ', '').replace(/,/g, '').trim();
        totalComision += parseFloat(c) || 0;
      }
    });

    var totalPrecioElem = document.getElementById('total-precio-footer');
    var totalComisionElem = document.getElementById('total-comision-footer');

    if (totalPrecioElem) {
      totalPrecioElem.textContent = 'S/ ' + totalPrecio.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    if (totalComisionElem) {
      totalComisionElem.textContent = 'S/ ' + totalComision.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
  }

  // Cerrar dropdown al hacer clic fuera
  document.addEventListener('click', function() {
    var dropdown = document.getElementById('cliente-filter-dropdown');
    if (dropdown) dropdown.classList.remove('active');
  });

  // Ordenar por defecto al cargar
  ordenarFilasVendedor(true);
})();
</script>
