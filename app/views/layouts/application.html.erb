<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Calculador de Comisiones | Dashboard</title>
  <meta name="description" content="Dashboard de comisiones estilo Power BI">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <!-- SheetJS para Exportación a Excel -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

  <script type="module">
    import * as Turbo from "https://cdn.jsdelivr.net/npm/@hotwired/turbo@7.3.0/+esm";
    import { Application, Controller } from "https://cdn.jsdelivr.net/npm/@hotwired/stimulus@3.2.2/+esm";

    const application = Application.start();
    window.Turbo = Turbo; // Hacer Turbo accesible globalmente

    // Controlador Stimulus para el Panel de Control (Dashboard)
    application.register("dashboard", class extends Controller {
      static targets = ["content", "vendorSelect", "dateSelect", "yearSelect", "canceladoSelect", 
                        "editIcon", "commissionColumn", "selectAllCheckbox", "itemCheckbox",
                        "vendorTrigger", "comisionPagadaSelect"]

      connect() {
        // Recuperar la pestaña activa actual
        this.currentTab = document.querySelector('.tab-btn.active')?.dataset.tab || "vendedor";
        this.basePath = this.getBasePath();
        this.loadProductDescriptions();
        this.pendingChanges = false;
        // Snapshot del formulario al cargar — detecta si el usuario cambió algo
        this._filterSnapshot = this._getFormSnapshot();

        // Cerrar dropdowns al hacer click fuera y ACTUALIZAR si hubo cambios
        document.addEventListener("click", (e) => {
          if (!e.target.closest('.multiselect-container')) {
            const openDropdowns = document.querySelectorAll('.multiselect-dropdown.show');
            if (openDropdowns.length > 0) {
              openDropdowns.forEach(d => d.classList.remove('show'));
              // El usuario terminó la selección al hacer click fuera
              this.filterChanged(e);
            }
          }
        });

        // Escuchar el evento del date range picker (OK)
        document.getElementById('filter-form')?.addEventListener('drp:changed', () => {
          this.filterChanged();
        });

        // Soporte para tecla Enter para aplicar filtros rápidamente
        document.addEventListener("keydown", (e) => {
          if (e.key === "Enter") {
            const openDropdowns = document.querySelectorAll('.multiselect-dropdown.show');
            if (openDropdowns.length > 0) {
              e.preventDefault();
              openDropdowns.forEach(d => d.classList.remove('show'));
              this.filterChanged();
            }
          }
        });
      }

      toggleDropdown(e) {
        e.stopPropagation();
        const container = e.currentTarget.closest('.multiselect-container');
        const dropdown = container.querySelector('.multiselect-dropdown');
        
        // Si vamos a cerrar el dropdown actual al hacerle click de nuevo
        const isCurrentlyOpen = dropdown.classList.contains('show');
        
        // Cerrar otros dropdowns abiertos
        document.querySelectorAll('.multiselect-dropdown.show').forEach(d => {
          if (d !== dropdown) d.classList.remove('show');
        });
        
        dropdown.classList.toggle('show');
        
        // Si se cerró explícitamente, disparamos la actualización
        if (isCurrentlyOpen) {
          this.filterChanged();
        }
      }


      updateCommission(e) {
        const checkbox = e.target;
        const url = checkbox.dataset.url;
        const paid = checkbox.checked;
        
        console.log(`Actualizando comisión URL ${url} a pagada=${paid}`);
        
        checkbox.style.opacity = '0.5';
        
        fetch(`${this.basePath}update_commission`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
          },
          body: JSON.stringify({ url: url, paid: paid })
        })
        .then(r => {
          if (r.status === 401) {
            window.location.reload();
            return;
          }
          return r.json().then(data => ({ status: r.status, ok: r.ok, data }));
        })
        .then(({ ok, data }) => {
          if (ok && data.success) {
            this.showToast("Estado de comisión actualizado", "success");
          } else {
            // Mostrar el mensaje EXACTO que devolvió la API
            const msg = data.error || "Error desconocido en el servidor";
            this.showToast(`Error de la API: ${msg}`, "error");
            checkbox.checked = !paid; // Revertir
          }
        })
        .catch(err => {
          console.error("Error AJAX:", err);
          this.showToast("No se pudo conectar con el servidor", "error");
          checkbox.checked = !paid; // Revertir
        })
        .finally(() => {
          checkbox.style.opacity = '1';
        });
      }

      refreshCache() {
        if (window.showLoader) window.showLoader();
        
        fetch(`${this.basePath}refresh_cache`)
          .then(r => r.json())
          .then(data => {
            if (data.success) {
              this.showToast(data.message, "success");
              // Opcional: Recargar la página para ver reflejados los cambios inmediatamente
              setTimeout(() => {
                window.location.reload();
              }, 1500);
            } else {
              this.showToast(data.error || "Error al refrescar tablas", "error");
              if (window.hideLoader) window.hideLoader();
            }
          })
          .catch(err => {
            console.error("Refresh Cache Error:", err);
            this.showToast("No se pudo conectar con el servidor", "error");
            if (window.hideLoader) window.hideLoader();
          });
      }

        // Seleccionar/Deseleccionar todos en la TABLA actual
        toggleSelectAll(e) {
          const checked = e.target.checked;
          const table = e.target.closest('table');
          if (!table) return;
          
          const checkboxes = table.querySelectorAll('.commission-checkbox:not([disabled])');
          checkboxes.forEach(cb => {
            if (cb.checked !== checked) {
              cb.checked = checked;
              cb.dispatchEvent(new Event('change'));
            }
          });
        }

        // Seleccionar/Deseleccionar solo los de un contenedor específico (una fila de supervisor)
        toggleRowSelectAll(e) {
          const checked = e.target.checked;
          const container = e.target.closest('td');
          if (!container) return;
          
          const checkboxes = container.querySelectorAll('.commission-checkbox:not([disabled])');
          checkboxes.forEach(cb => {
            if (cb.checked !== checked) {
              cb.checked = checked;
              cb.dispatchEvent(new Event('change'));
            }
          });
        }

        // Seleccionar/Deseleccionar todos en el filtro de vendedores
        toggleVendorTodas(e) {
          const isChecked = e.target.checked;
          const dropdown = e.target.closest('.multiselect-dropdown');
          if (dropdown) {
            const otherCheckboxes = dropdown.querySelectorAll('input[name="vendor[]"]:not(#vendor_todas)');
            otherCheckboxes.forEach(cb => cb.checked = isChecked);
          }
        }

        toggleDateRange(e) {
          const isChecked = e.target.checked;
          const group = document.getElementById('date-range-group');
          if (group) {
            group.classList.toggle('disabled', !isChecked);
            const trigger = group.querySelector('.drp-trigger');
            if (trigger) trigger.disabled = !isChecked;
          }
          this.filterChanged();
        }
      onItemCheckboxChange() {
        this.pendingChanges = true;
      }

      massUpdateCommissions() {
        const updates = this.itemCheckboxTargets
          .filter(cb => {
            // Comparar estado actual con el estado inicial (atributo checked de HTML)
            const initialState = cb.defaultChecked;
            return cb.checked !== initialState;
          })
          .map(cb => ({
            url: cb.dataset.url,
            paid: cb.checked,
            invoice_number: cb.dataset.invoiceNumber,
            commission_amount: cb.dataset.commissionAmount,
            vendor_name: cb.dataset.vendor || ''
          }));

        if (updates.length === 0) {
          this.showToast("No hay cambios para guardar", "info");
          return;
        }

        if (window.showLoader) window.showLoader();

        const tipoMap = { vendedor: 'Vendedor', productos: 'Producto', supervisor: 'Supervisor' };
        const tipo_comision = tipoMap[this.currentTab] || 'Vendedor';

        fetch(`${this.basePath}mass_update_commissions`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
          },
          body: JSON.stringify({ updates: updates, tipo_comision: tipo_comision })
        })
        .then(r => {
          if (r.status === 401) {
            window.location.reload();
            return;
          }
          return r.json();
        })
        .then(data => {
          if (data.success) {
            this.showToast(data.message, "success");
            // Redirigir a la pestaña de historial tras un update exitoso
            setTimeout(() => {
              window.location.href = `${this.basePath}?tab=historial`;
            }, 1000);
          } else {
            this.showToast(data.message, "error");
            if (window.hideLoader) window.hideLoader();
          }
        })
        .catch(err => {
          console.error("Mass Update Error:", err);
          this.showToast("Error al realizar la actualización masiva");
          if (window.hideLoader) window.hideLoader();
        });
      }

      getBasePath() {
        // Obtener el subpath actual (ej: /app_comisiones/)
        const path = window.location.pathname;
        if (path.includes('/app_comisiones')) {
          return '/app_comisiones/';
        }
        return '/';
      }

      // Snapshot del formulario para detectar cambios antes de recargar
      _getFormSnapshot() {
        const form = document.getElementById('filter-form');
        if (!form) return '';
        const params = new URLSearchParams(new FormData(form));
        params.sort();
        return params.toString();
      }

      filterChanged(e) {
        // Ignorar si el click fue sobre el disparador del DateRangePicker
        if (e && e.target && (e.target.closest('.drp-trigger') || e.target.classList.contains('drp-trigger'))) {
          console.log('[filtro] Click en drp-trigger detectado, ignorando filterChanged prematuro');
          return;
        }

        const current = this._getFormSnapshot();
        if (current === this._filterSnapshot) {
          console.log('[filtro] Sin cambios, omitiendo consulta a la API');
          return;
        }

        if (this.currentTab === 'supervisor') {
          const currentParams = new URLSearchParams(current);
          const oldParams = new URLSearchParams(this._filterSnapshot);
          
          // Comprobar si algo que NO sea vendor[] ha cambiado
          let otherChanged = false;
          // Unificamos todas las llaves para comparar
          const allKeys = new Set([...currentParams.keys(), ...oldParams.keys()]);
          
          for (let key of allKeys) {
            // Ignorar tanto "vendor[]" como la variante codificada "vendor%5B%5D"
            if (key.includes('vendor')) continue;
            
            if (currentParams.get(key) !== oldParams.get(key)) {
              otherChanged = true;
              break;
            }
          }
          
          if (!otherChanged) {
            console.log('[filtro] Solo se cambió el filtro de vendedores en Supervisor. No se requiere recarga.');
            this._filterSnapshot = current;
            return;
          }
        }

        if (window.showLoader) window.showLoader();

        const form = document.getElementById('filter-form');
        const formData = new FormData(form);
        const params = new URLSearchParams();

        params.set("tab", this.currentTab);

        for (const [key, value] of formData.entries()) {
          params.append(key, value);
        }

        const url = `${window.location.pathname}?${params.toString()}`;
        console.log(`[filtro] Navegando via Turbo a: ${url}`);
        
        try {
          if (window.Turbo) {
            window.Turbo.visit(url);
          } else {
            window.location.href = url;
          }
        } catch (err) {
          console.error("[filtro] Error en Turbo.visit, usando navegación estándar:", err);
          window.location.href = url;
        }
      }

      switchTab(e) {
        const tab = e.currentTarget.dataset.tab;
        if (!tab) return;
        
        this.currentTab = tab;
        
        // Retroalimentación de la Interfaz de Usuario (UI)
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        e.currentTarget.classList.add('active');

        const form = document.getElementById('filter-form');
        
        // --- LÓGICA DE EXCEPCIONES AL CAMBIAR DE PESTAÑA ---
        
        // 1. Excepción Historial: Filtro vendedores siempre vacío
        if (tab === 'historial') {
          console.log('[filtro] Aplicando excepción Historial: vaciando vendedores');
          form.querySelectorAll('input[name="vendor[]"]').forEach(cb => cb.checked = false);
          if (this.hasVendorTriggerTarget) {
            this.vendorTriggerTarget.querySelector('span').innerText = '— Sin selección (resumen)';
          }
        }
        
        // 2. Excepción Supervisor: Pago Comisión por defecto Pendiente (N)
        if (tab === 'supervisor') {
          console.log('[filtro] Aplicando excepción Supervisor: seteando a Pendiente');
          if (this.hasComisionPagadaSelectTarget) {
            this.comisionPagadaSelectTarget.value = 'N';
          }
        }

        if (window.showLoader) window.showLoader();

        // Capturar los datos del formulario DESPUÉS de aplicar las excepciones
        const formData = new FormData(form);
        const params = new URLSearchParams(formData);
        params.set('tab', tab);

        // Usar ruta absoluta dinámica para respetar el subpath (/app_comisiones/)
        fetch(`${this.basePath}${tab}?${params.toString()}`, {
          headers: { "X-Requested-With": "XMLHttpRequest" }
        })
          .then(r => {
            if (r.status === 401) {
              window.location.reload(); // Forzar recarga si la sesión expiró
              return;
            }
            if (!r.ok) {
              // Leer el cuerpo del error para mostrar el mensaje real
              return r.text().then(body => {
                let errorMsg = "El servidor encontró un problema";
                try {
                  const parsed = JSON.parse(body);
                  if (parsed.error) errorMsg = parsed.error;
                } catch (_) { /* body no es JSON */ }
                throw new Error(errorMsg);
              });
            }
            return r.text();
          })
          .then(html => {
            if (this.hasContentTarget) {
              this.contentTarget.innerHTML = html;
              // Los navegadores no autoejecutan scripts inyectados vía innerHTML.
              // Re-insertamos cada script para que se ejecute (arregla toggle de historial, scroll infinito, etc.)
              this.contentTarget.querySelectorAll('script').forEach(old => {
                try {
                  const s = document.createElement('script');
                  s.textContent = old.textContent;
                  old.replaceWith(s);
                } catch (e) {
                  console.warn("[Dashboard] Error al re-ejecutar script inyectado:", e);
                }
              });
            }
            // Actualizar el snapshot después de cargar la nueva pestaña con sus filtros actuales
            this._filterSnapshot = this._getFormSnapshot();
            if (window.hideLoader) window.hideLoader();
            this.loadProductDescriptions();
          })
          .catch(err => {
            console.error("Tab Error:", err);
            if (window.hideLoader) window.hideLoader();
            this.showToast(`No se pudo cargar la pestaña: ${err.message}`, 'error');
          });
      }

      showToast(message, type = 'error') {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `toast toast-${type}`;
        toast.innerHTML = `
          <span class="toast-icon">⚠️</span>
          <div class="toast-content">${message}</div>
        `;
        
        toast.onclick = () => {
          toast.style.animation = 'toastFadeOut 0.3s forwards';
          setTimeout(() => toast.remove(), 300);
        };

        container.appendChild(toast);

        // Eliminación automática (Más tiempo para errores: 20s, otros: 5s)
        const duration = type === 'error' ? 20000 : 5000;
        setTimeout(() => {
          if (toast.parentNode) {
            toast.style.animation = 'toastFadeOut 0.3s forwards';
            setTimeout(() => toast.remove(), 300);
          }
        }, duration);
      }

      toggleCommissionEdit() {
        const columns = this.commissionColumnTargets;
        const iconNodes = this.editIconTargets;
        
        if (columns.length === 0) return;
        
        const isVisible = columns[0].style.display !== 'none';
        
        if (isVisible) {
          // Si estamos cerrando y hubo cambios, guardamos masivamente
          if (this.pendingChanges) {
            this.massUpdateCommissions();
            this.pendingChanges = false;
          }
          columns.forEach(col => col.style.display = 'none');
          
          iconNodes.forEach(btn => {
            btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-edit"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>`;
            btn.title = "Editar comisiones";
          });
        } else {
          // Abriendo modo edición
          columns.forEach(col => col.style.display = 'table-cell');
          this.pendingChanges = false;
          
          iconNodes.forEach(btn => {
            btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;
            btn.title = "Guardar cambios y refrescar";
          });
          this.showToast("Modo edición activado. Selecciona las comisiones pagadas y presiona el check para guardar.", "info");
        }
      }



      // Carga asíncrona y progresiva de descripciones de productos
      loadProductDescriptions() {
        const slots = Array.from(document.querySelectorAll('[data-product-code]'));
        if (slots.length === 0) return;

        // Obtener códigos únicos que aún no han sido procesados
        const codesToFetch = [...new Set(
          slots
            .filter(slot => !slot.dataset.processed)
            .map(slot => slot.dataset.productCode)
        )];

        if (codesToFetch.length === 0) return;

        // Procesar en lotes de 15 para un efecto progresivo "ítem por ítem"
        const batchSize = 15;
        for (let i = 0; i < codesToFetch.length; i += batchSize) {
          const batch = codesToFetch.slice(i, i + batchSize);
          this.fetchBatch(batch, slots);
        }
      }

      fetchBatch(batch, allSlots) {
        // Mostrar indicador de carga "..." animado en los slots
        batch.forEach(code => {
          const matchingSlots = allSlots.filter(s => s.dataset.productCode === code);
          matchingSlots.forEach(slot => {
            const nameSpan = slot.querySelector('.product-name');
            if (nameSpan && !slot.dataset.processed) {
              nameSpan.innerHTML = `${code} <span class="loading-dots">...</span>`;
            }
          });
        });

        const codesParam = batch.join(',');
        console.log(`Buscando descripciones para: ${codesParam}`);
        
        fetch(`${this.basePath}products?codes=${encodeURIComponent(codesParam)}`)
          .then(r => r.json())
          .then(productsMap => {
            console.log("Respuesta de productos:", productsMap);
            allSlots.forEach(slot => {
              const code = slot.dataset.productCode;
              if (productsMap[code]) {
                const nameSpan = slot.querySelector('.product-name');
                if (nameSpan) {
                  nameSpan.style.opacity = '0';
                  setTimeout(() => {
                    nameSpan.textContent = productsMap[code];
                    nameSpan.style.opacity = '1';
                    nameSpan.style.transition = 'opacity 0.5s ease';
                  }, 200);
                  slot.title = productsMap[code];
                  slot.dataset.processed = "true";
                }
              } else {
                // Si no se encontró, quitar los puntitos para no confundir
                const nameSpan = slot.querySelector('.product-name');
                if (nameSpan && !slot.dataset.processed) {
                  nameSpan.textContent = code;
                }
              }
            });
          })
          .catch(err => {
            console.error("Error cargando lote de productos:", err);
            // Revertir a solo código en caso de error
            batch.forEach(code => {
              const matchingSlots = allSlots.filter(s => s.dataset.productCode === code);
              matchingSlots.forEach(slot => {
                const nameSpan = slot.querySelector('.product-name');
                if (nameSpan && !slot.dataset.processed) nameSpan.textContent = code;
              });
            });
          });
      }

      // Exportar tabla a Excel con formato numérico correcto
      exportToExcel(e) {
        // Buscar la tabla dentro de la misma sección de tabla para permitir múltiples tablas en una vista
        const tableContainer = e?.target?.closest('.table-section');
        const table = tableContainer ? tableContainer.querySelector('.data-table') : document.querySelector('.data-table');
        
        if (!table) {
          alert("No hay tabla para exportar");
          return;
        }

        // Determinar el método de exportación: Supervisor o General
        // Si el contenedor tiene h3 que mencione Supervisores, o si estamos en tab supervisor
        const isSupervisorTable = (tableContainer && tableContainer.innerText.includes("Supervisores")) || (this.currentTab === 'supervisor');

        if (isSupervisorTable) {
          this._exportSupervisorToExcel(table);
          return;
        }

        // === CASO GENERAL: Vendedor / Productos ===
        const tableCopy = table.cloneNode(true);
        
        // Hacer visibles las columnas de vendedor para el Excel
        tableCopy.querySelectorAll('.col-vendedor').forEach(el => {
          el.style.display = '';
        });

        const dateRegex = /^\d{2}\/\d{2}\/\d{4}$/;

        // Limpiar símbolos de moneda y proteger fechas
        tableCopy.querySelectorAll('td').forEach(td => {
          let text = td.innerText.trim();

          // Si el texto es una fecha en formato DD/MM/YYYY, anteponer comilla simple
          // para forzar a Excel a tratarlo como texto y no reinterpretarlo
          if (dateRegex.test(text)) {
            td.setAttribute('data-t', 's');
          } else if (text.startsWith('S/')) {
            let numericValue = text.replace(/S\/\s?/, '').replace(/,/g, '');
            td.innerText = numericValue;
            td.setAttribute('data-t', 'n');
          }
        });

        const wb = XLSX.utils.table_to_book(tableCopy, { sheet: "Comisiones", raw: false });

        // Forzar texto en celdas de fecha
        const ws = wb.Sheets["Comisiones"];
        if (ws) {
          Object.keys(ws).forEach(key => {
            if (key.startsWith('!')) return;
            const cell = ws[key];
            if (typeof cell.v === 'string' && dateRegex.test(cell.v.trim())) {
              cell.t = 's';
              cell.z = '@';
            }
          });
        }

        const fileName = `Comisiones_${this.currentTab}_${new Date().toISOString().slice(0,10)}.xlsx`;
        XLSX.writeFile(wb, fileName);
      }

      _exportSupervisorToExcel(table) {
        // --- Utilidades ---
        const getDivTexts = (td) => {
          const divs = td.querySelectorAll('div');
          return divs.length > 0
            ? Array.from(divs).map(d => d.innerText.trim()).filter(t => t.length > 0)
            : [td.innerText.trim()];
        };

        const cleanAmount = (text) => {
          if (typeof text === 'string' && text.includes('S/')) {
            const n = parseFloat(text.replace(/S\/\s?/, '').replace(/,/g, ''));
            return isNaN(n) ? text : n;
          }
          return text;
        };

        // --- Hoja 1: Resumen por Supervisor / Vendedor ---
        const summaryHeaders = ['Supervisor', 'Comisión (%)', 'Vendedor', 'Comisión Vendedor (S/)', 'Comisión Supervisor (S/)'];
        const summaryRows = [summaryHeaders];

        // Datos por supervisor para las hojas de detalle
        const supervisorSheets = []; // [{ name, invoiceRows[] }]

        const bodyRows = table.querySelectorAll('tbody tr');
        bodyRows.forEach(tr => {
          const tds = tr.querySelectorAll('td');
          if (tds.length < 5) return;

          const supervisor  = tds[0].innerText.trim();
          const comisionPct = tds[1].innerText.trim();
          const vendedores  = getDivTexts(tds[2]);
          const comVendedor = getDivTexts(tds[3]);
          const comSuper    = getDivTexts(tds[4]);

          // Filas de resumen
          vendedores.forEach((vend, i) => {
            const cvText  = comVendedor[i] || '';
            const csText  = comSuper[i]    || '';
            summaryRows.push([
              i === 0 ? supervisor  : '',
              i === 0 ? comisionPct : '',
              vend,
              cleanAmount(cvText),
              cleanAmount(csText)
            ]);
          });
          summaryRows.push(['', '', '', '', '']); // separador

          // --- Hoja de detalle por supervisor ---
          // La columa de edición (índice 5 o el último td visible) tiene los checkboxes
          const commissionTd = tr.querySelector('td[data-dashboard-target="commissionColumn"]');
          if (commissionTd) {
            const invoiceRows = [['Vendedor', 'Nro. Factura', 'Producto', 'Comisión (S/)', 'Pagada']];

            commissionTd.querySelectorAll('.commission-checkbox').forEach(cb => {
              const vendor    = cb.dataset.vendor          || '';
              const invoice   = cb.dataset.invoiceNumber   || '';
              const amount    = parseFloat(cb.dataset.commissionAmount) || 0;
              const pagada    = cb.checked ? 'SI' : 'NO';

              // Extraer el código de producto del span hermano (texto: "FAC -> PROD")
              const span = cb.closest('div')?.querySelector('span');
              const labelText = span ? span.innerText.trim() : '';
              const parts = labelText.split('->');
              const producto = parts.length > 1 ? parts[1].trim() : labelText;

              invoiceRows.push([vendor, invoice, producto, amount, pagada]);
            });

            if (invoiceRows.length > 1) {
              // Nombre de hoja: primeros 28 chars para respetar límite de Excel
              const sheetName = supervisor.substring(0, 28).trim();
              supervisorSheets.push({ name: sheetName, rows: invoiceRows });
            }
          }
        });

        // Total del tfoot — usar el td visible (el que NO está oculto)
        const tfootRow = table.querySelector('tfoot tr');
        if (tfootRow) {
          const tfootTds = tfootRow.querySelectorAll('td:not([style*="display: none"])');
          // tfootTds[0] = colspan=4 con el label, tfootTds[1] = el monto
          const totalTd  = tfootTds[1] || tfootTds[0];
          const totalText = totalTd?.innerText?.trim() || '';
          summaryRows.push(['Total Comisión Supervisores', '', '', '', cleanAmount(totalText)]);
        }

        // --- Construir el workbook ---
        const wb = XLSX.utils.book_new();

        // Hoja de resumen (primera)
        const wsSummary = XLSX.utils.aoa_to_sheet(summaryRows);
        wsSummary['!cols'] = [
          { wch: 30 }, { wch: 14 }, { wch: 34 }, { wch: 24 }, { wch: 24 }
        ];
        XLSX.utils.book_append_sheet(wb, wsSummary, 'Resumen');

        // Una hoja por supervisor
        supervisorSheets.forEach(({ name, rows }) => {
          const ws = XLSX.utils.aoa_to_sheet(rows);
          ws['!cols'] = [
            { wch: 34 }, // Vendedor
            { wch: 16 }, // Nro. Factura
            { wch: 36 }, // Producto
            { wch: 16 }, // Comisión
            { wch: 10 }, // Pagada
          ];
          // Evitar nombre de hoja duplicado agregando un sufijo si fuera necesario
          let sheetName = name;
          let suffix = 2;
          while (wb.SheetNames.includes(sheetName)) {
            sheetName = `${name.substring(0, 25)} ${suffix++}`;
          }
          XLSX.utils.book_append_sheet(wb, ws, sheetName);
        });

        const fileName = `Comisiones_supervisor_${new Date().toISOString().slice(0, 10)}.xlsx`;
        XLSX.writeFile(wb, fileName);
      }
    });

    // Controlador para Gráficos
