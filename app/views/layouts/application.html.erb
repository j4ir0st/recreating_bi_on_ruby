    .tabs {
      display:flex; gap:4px; margin-bottom:24px; background:var(--bg-secondary);
      border-radius:var(--radius-md); padding:4px; width:fit-content;
      max-width: 100%; overflow-x: auto; white-space: nowrap;
      scrollbar-width: none; /* Firefox */
      -ms-overflow-style: none; /* IE 10+ */
    }
    .tabs::-webkit-scrollbar { display: none; } /* Chrome, Safari, Opera */
    .btn-excel {
      background: rgba(72,187,120,0.1); color: var(--accent-green);
      border: 1px solid rgba(72,187,120,0.3); border-radius: var(--radius-md);
      padding: 6px 12px; font-size: 0.8rem; font-weight: 600; cursor: pointer;
      display: flex; align-items: center; gap: 8px; transition: var(--transition);
    }
    .btn-excel:hover { 
      background: var(--accent-green); color: white; 
      box-shadow: 0 0 15px rgba(72,187,120,0.4); 
    }

    .tab-btn {
      padding:8px 24px; border:none; border-radius:6px; background:transparent;
      color:var(--text-secondary); font-family:'Inter',sans-serif; font-size:0.9rem;
      font-weight:500; cursor:pointer; transition:var(--transition);
      flex-shrink: 0; /* No encoger botones en móvil */
    }
    .tab-btn:hover { color:var(--text-primary); background:rgba(255,255,255,0.05); }
    .tab-btn.active {
      background:var(--bg-card); color:var(--text-primary);
      box-shadow:0 2px 8px rgba(0,0,0,0.2);
    }

    .kpi-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:24px; }
    .kpi-card {
      background:var(--bg-card); border:1px solid var(--border-color);
      border-radius:var(--radius-lg); padding:20px 24px; text-align:center;
      transition:var(--transition); position:relative; overflow:hidden;
      animation: fadeInUp 0.5s ease-out forwards;
    }
    .kpi-card::before {
      content:''; position:absolute; top:0; left:0; right:0; height:3px;
      border-radius:var(--radius-lg) var(--radius-lg) 0 0;
    }
    .kpi-card:nth-child(1)::before { background:var(--accent-blue); }
    .kpi-card:nth-child(2)::before { background:var(--accent-orange); }
    .kpi-card:nth-child(3)::before { background:var(--accent-cyan); }
    .kpi-card:nth-child(4)::before { background:var(--accent-purple); }
    .kpi-card:hover { transform:translateY(-2px); box-shadow:var(--shadow-glow); border-color:rgba(0,212,255,0.3); }
    .kpi-card:nth-child(2) { animation-delay:0.05s; }
    .kpi-card:nth-child(3) { animation-delay:0.1s; }
    .kpi-card:nth-child(4) { animation-delay:0.15s; }

    .kpi-value { font-size:1.6rem; font-weight:700; margin-bottom:6px; letter-spacing:-0.5px; }
    .kpi-card:nth-child(1) .kpi-value { color:var(--accent-blue); }
    .kpi-card:nth-child(2) .kpi-value { color:var(--accent-orange); }
    .kpi-card:nth-child(3) .kpi-value { color:var(--accent-cyan); }
    .kpi-card:nth-child(4) .kpi-value { color:var(--accent-purple); }
    .kpi-label { font-size:0.8rem; color:var(--text-secondary); font-weight:500; }

    .table-section {
      background:var(--bg-card); border:1px solid var(--border-color);
      border-radius:var(--radius-lg); overflow:hidden; margin-bottom:24px;
      animation: fadeInUp 0.5s ease-out forwards;
    }
    .table-header { padding:16px 20px; border-bottom:1px solid var(--border-color); }
    .table-header h3 { font-size:1rem; font-weight:600; color:var(--text-primary); }
    .table-header p { font-size:0.75rem; color:var(--text-muted); margin-top:2px; }

    .table-wrapper { max-height:500px; overflow-y:auto; }
    .table-wrapper::-webkit-scrollbar { width:6px; }
    .table-wrapper::-webkit-scrollbar-track { background:var(--bg-secondary); }
    .table-wrapper::-webkit-scrollbar-thumb { background:var(--border-color); border-radius:3px; }

    .data-table { width:100%; border-collapse:collapse; }
    .data-table thead th {
      background:var(--bg-table-header); padding:12px 16px; text-align:left;
      font-size:0.8rem; font-weight:600; color:var(--text-secondary);
      text-transform:uppercase; letter-spacing:0.5px; position:sticky; top:0; z-index:10;
      border-bottom:2px solid var(--border-color);
    }
    .data-table td {
      padding: 10px 16px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      font-size: 0.85rem;
      color: var(--text-primary);
      font-variant-numeric: tabular-nums;
    }
    .data-table tbody tr {
      border-bottom:1px solid rgba(255,255,255,0.03); transition:var(--transition);
    }
    .data-table tbody tr:nth-child(even) { background:rgba(255,255,255,0.02); }
    .data-table tbody tr:hover { background:rgba(0,212,255,0.05); }
    .data-table tfoot td {
      background:var(--bg-table-header); padding:12px 16px; font-size:0.85rem;
      font-weight:700; color:var(--text-primary); border-top:2px solid var(--accent-blue);
      font-variant-numeric: tabular-nums;
      position:sticky; bottom:0;
    }

    .text-right { text-align:right; }
    .text-center { text-align:center; }

    .chart-section {
      background:var(--bg-card); border:1px solid var(--border-color);
      border-radius:var(--radius-lg); padding:20px; margin-bottom:24px;
      animation: fadeInUp 0.5s ease-out forwards;
    }
    .chart-section h3 { font-size:1rem; font-weight:600; color:var(--text-primary); margin-bottom:16px; }
    .chart-container { position:relative; height:400px; }

    .status-badge {
      display:inline-block; padding:3px 10px; border-radius:12px;
      font-size:0.7rem; font-weight:600; letter-spacing:0.3px;
    }

    input[type="checkbox"] {
      cursor: pointer;
      width: 1.15rem;
      height: 1.15rem;
      accent-color: var(--accent-cyan);
      vertical-align: middle;
    }

    .commission-checkbox:disabled {
      cursor: not-allowed;
      opacity: 0.5;
    }
    .status-paid { background:rgba(72,187,120,0.15); color:#48bb78; border:1px solid rgba(72,187,120,0.3); }
    .status-pending { background:rgba(255,107,53,0.12); color:#ff6b35; border:1px solid rgba(255,107,53,0.3); }

    /* Clases de Producto */
    .status-badge.clase-a { background:rgba(0,212,255,0.15); color:#00d4ff; border:1px solid rgba(0,212,255,0.3); }
    .status-badge.clase-b { background:rgba(159,122,234,0.15); color:#9f7aea; border:1px solid rgba(159,122,234,0.3); }
    .status-badge.clase-c { background:rgba(237,137,54,0.15); color:#ed8936; border:1px solid rgba(237,137,54,0.3); }

    /* === LOADING OVERLAY === */
    #global-loader {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(15, 19, 35, 0.7);
      backdrop-filter: blur(4px);
      z-index: 9999;
      display: none; /* Hidden by default */
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: var(--accent-blue);
      pointer-events: none; /* Seguridad: No bloquea clics cuando display:none no funciona */
    }
    #global-loader.active { display: flex; pointer-events: auto; }
    
    .spinner {
      width: 50px; height: 50px;
      border: 3px solid rgba(0, 212, 255, 0.3);
      border-radius: 50%;
      border-top-color: var(--accent-blue);
      animation: spin 1s ease-in-out infinite;
      margin-bottom: 16px;
    }
    
    .loading-text {
      font-size: 0.9rem; font-weight: 600; color: var(--text-primary);
      letter-spacing: 0.5px; animation: pulse 1.5s infinite;
    }

    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }

    .btn-loader {
      width: 18px; height: 18px;
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-radius: 50%;
      border-top-color: #fff;
      animation: spin 0.8s linear infinite;
    }

    .loading-dots {
      color: var(--accent-orange);
      font-weight: bold;
      animation: pulse 0.8s infinite;
      margin-left: 6px;
      display: inline-block;
    }

    .product-name {
      transition: opacity 0.3s ease;
    }

    @keyframes fadeInUp {
      from { opacity:0; transform:translateY(16px); }
      to { opacity:1; transform:translateY(0); }
    }

    @media (max-width:1024px) { .kpi-grid { grid-template-columns:repeat(2,1fr); } }
    @media (max-width:768px) {
      .dashboard-container { padding:16px; }
      .header { flex-direction:column; gap:16px; }
      .header-right { text-align:left; }
      .kpi-grid { grid-template-columns:1fr; }
      .header-left h1 { font-size:1.5rem; }
    }

    /* Estilos de Notificaciones Toast */
    .toast-container {
      position: fixed; top: 20px; right: 20px; z-index: 9999;
      display: flex; flex-direction: column; gap: 10px; pointer-events: none;
    }
    .toast {
      pointer-events: auto; padding: 16px 24px; border-radius: 12px;
      backdrop-filter: blur(10px); color: white; min-width: 300px;
      max-width: 500px; /* Limitar ancho para que no ocupe toda la pantalla */
      display: flex; align-items: flex-start; gap: 15px; /* Alinear al inicio para mensajes largos */
      box-shadow: 0 10px 40px rgba(0,0,0,0.5);
      animation: toastSlideIn 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
      font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 500;
      max-height: 300px; overflow-y: auto; /* Permitir scroll si es demasiado largo */
    }
    .toast-content {
      word-break: break-word; /* Asegurar que palabras largas se rompan */
      line-height: 1.4;
      flex: 1;
    }
    .toast-error { 
      background: rgba(239, 68, 68, 0.95); border: 2px solid rgba(255,255,255,0.3);
      box-shadow: 0 0 30px rgba(239, 68, 68, 0.5);
    }
    .toast-icon { font-size: 1.2rem; margin-top: 2px; }
    
    @keyframes toastSlideIn {
      from { transform: translateX(120%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
    @keyframes toastFadeOut {
      from { transform: translateX(0); opacity: 1; }
      to { transform: translateX(120%); opacity: 0; }
    }
    /* Dropdown Multiselección Personalizado */
    .multiselect-container {
      position: relative; width: 100%;
    }
    .multiselect-trigger {
      padding: 6px 10px; background: var(--bg-secondary);
      border: 1px solid var(--border-color); border-radius: 4px;
      cursor: pointer; display: flex; justify-content: space-between;
      align-items: center; min-height: 38px; font-size: 0.85rem;
    }
    .multiselect-trigger:hover { border-color: var(--accent-blue); }
    .multiselect-dropdown {
      position: absolute; top: 100%; left: 0; right: 0;
      background: var(--bg-card); border: 1px solid var(--border-color);
      border-radius: 6px; margin-top: 4px; max-height: 250px;
      overflow-y: auto; z-index: 1000; display: none;
      box-shadow: 0 10px 25px rgba(0,0,0,0.3); padding: 8px 0;
    }
    .multiselect-dropdown.show { display: block; }
    .multiselect-option {
      padding: 8px 12px; display: flex; align-items: center; gap: 10px;
      transition: background 0.2s; cursor: pointer;
    }
    .multiselect-option:hover { background: rgba(255,255,255,0.05); }
    .multiselect-option input[type="checkbox"] {
      width: 16px; height: 16px; accent-color: var(--accent-orange);
    }
    .multiselect-option label {
      cursor: pointer; flex-grow: 1; margin: 0;
      font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    .commission-checkbox {
      width: 18px; height: 18px; cursor: pointer; accent-color: var(--accent-orange);
    }

    /* Mejoras de área de toque para móvil */
    @media (max-width: 768px) {
      .btn-icon, .btn-excel, .tab-btn {
        min-height: 44px; /* Estándar de touch targets */
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .btn-icon svg { width: 22px; height: 22px; }
      .data-table thead th, .data-table tbody td {
        padding: 12px 10px; /* Más espacio para dedos */
      }
    }

    /* ===== SELECTOR DE RANGO DE FECHAS (DATE RANGE PICKER) ===== */
    .drp-trigger {
      padding: 6px 10px; background: var(--bg-secondary);
      border: 1px solid var(--border-color); border-radius: 4px;
      cursor: pointer; display: flex; justify-content: space-between;
      align-items: center; min-height: 38px; font-size: 0.85rem;
      color: var(--text-primary); width: 100%; transition: var(--transition);
      font-family: 'Inter', sans-serif;
    }
    .drp-trigger:hover { border-color: var(--accent-blue); }
    .drp-trigger .drp-label { flex: 1; text-align: left; }
    .drp-trigger svg { flex-shrink: 0; margin-left: 6px; color: var(--text-muted); }

    /* Capa de fondo del popup + tarjeta cargada */
    .drp-popup-overlay {
      display: none; position: fixed; inset: 0;
      z-index: 2000; background: rgba(0,0,0,0.45); backdrop-filter: blur(2px);
      align-items: center; justify-content: center;
      pointer-events: none;
    }
    .drp-popup-overlay.open { 
      display: flex; animation: fadeInPop 0.18s ease; 
      pointer-events: auto;
    }
    @keyframes fadeInPop {
      from { opacity: 0; transform: scale(0.96); }
      to   { opacity: 1; transform: scale(1); }
    }
    .drp-popup {
      background: var(--bg-card); border: 1px solid var(--border-color);
      border-radius: 14px; padding: 20px;
      box-shadow: 0 24px 60px rgba(0,0,0,0.6), 0 0 0 1px rgba(0,212,255,0.08);
      min-width: 300px; max-width: 340px; width: 94vw;
      font-family: 'Inter', sans-serif;
    }

    /* Navegación del encabezado */
    .drp-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 14px;
    }
    .drp-nav-btn {
      background: none; border: none; color: var(--text-secondary); cursor: pointer;
      padding: 4px 8px; border-radius: 6px; transition: var(--transition);
      font-size: 1rem; line-height: 1;
    }
    .drp-nav-btn:hover { background: rgba(0,212,255,0.1); color: var(--accent-cyan); }
    .drp-month-year {
      display: flex; gap: 6px; align-items: center;
    }
    .drp-month-btn, .drp-year-btn {
      background: none; border: none; cursor: pointer; font-family: 'Inter', sans-serif;
      font-size: 0.95rem; font-weight: 700; color: var(--text-primary);
      border-radius: 6px; padding: 4px 8px; transition: var(--transition);
    }
    .drp-month-btn:hover, .drp-year-btn:hover {
      background: rgba(0,212,255,0.12); color: var(--accent-cyan);
    }

    /* Cuadrícula de días */
    .drp-weekdays {
      display: grid; grid-template-columns: repeat(7, 1fr);
      margin-bottom: 4px;
    }
    .drp-weekdays span {
      text-align: center; font-size: 0.68rem; font-weight: 700;
      color: var(--text-muted); text-transform: uppercase; padding: 4px 0;
    }
    .drp-days {
      display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px;
    }
    .drp-day {
      text-align: center; padding: 7px 2px; font-size: 0.83rem;
      border-radius: 6px; cursor: pointer; color: var(--text-primary);
      transition: background 0.15s, color 0.15s; position: relative; z-index: 1;
      border: none; background: none; font-family: 'Inter', sans-serif;
    }
    .drp-day:hover:not(.drp-day-empty):not(.drp-day-disabled) {
      background: rgba(0,212,255,0.15); color: var(--accent-cyan);
    }
    .drp-day-empty { cursor: default; }
    .drp-day-disabled { color: var(--text-muted); cursor: not-allowed; opacity: 0.4; }
    .drp-day-in-range {
      background: rgba(11,197,234,0.12); border-radius: 0;
    }
    .drp-day-in-range:first-child, .drp-day-start + .drp-day-in-range { border-radius: 6px 0 0 6px; }
    .drp-day-start {
      background: var(--accent-cyan) !important; color: #0f1323 !important;
      font-weight: 700; border-radius: 6px;
    }
    .drp-day-end {
      background: var(--accent-green) !important; color: #0f1323 !important;
      font-weight: 700; border-radius: 6px;
    }
    .drp-day-start.drp-day-end {
      background: var(--accent-blue) !important;
    }

    /* Panel de Mes / Año (se muestra en lugar de la cuadrícula de días) */
    .drp-panel {
      display: none; grid-template-columns: repeat(3, 1fr); gap: 6px;
      margin-bottom: 4px;
    }
    .drp-panel.open { display: grid; }
    .drp-panel-item {
      text-align: center; padding: 9px 4px; font-size: 0.82rem;
      border-radius: 8px; cursor: pointer; color: var(--text-primary);
      transition: background 0.15s, color 0.15s;
      border: 1px solid transparent; font-family: 'Inter', sans-serif;
      background: none;
    }
    .drp-panel-item:hover { background: rgba(0,212,255,0.12); color: var(--accent-cyan); }
    .drp-panel-item.active {
      border-color: var(--accent-cyan); color: var(--accent-cyan);
      background: rgba(0,212,255,0.1);
    }
    .drp-panel-item.disabled { color: var(--text-muted); cursor: not-allowed; opacity: 0.4; }

    /* Línea de estado */
    .drp-status {
      margin-top: 10px; font-size: 0.78rem; color: var(--text-secondary);
      min-height: 20px; text-align: center;
    }
    .drp-status .drp-start-lbl { color: var(--accent-cyan); font-weight: 600; }
    .drp-status .drp-end-lbl   { color: var(--accent-green); font-weight: 600; }
    .drp-status .drp-arrow     { color: var(--text-muted); margin: 0 4px; }

    /* Botones del pie de página */
    .drp-footer {
      display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px;
      border-top: 1px solid var(--border-color); padding-top: 12px;
    }
    .drp-btn-reset {
      background: none; border: 1px solid var(--border-color); color: var(--text-secondary);
      border-radius: 6px; padding: 6px 14px; font-size: 0.82rem; cursor: pointer;
      font-family: 'Inter', sans-serif; transition: var(--transition);
    }
    .drp-btn-reset:hover { border-color: var(--accent-orange); color: var(--accent-orange); }
    .drp-btn-ok {
      background: rgba(0,212,255,0.15); border: 1px solid var(--accent-blue);
      color: var(--accent-blue); border-radius: 6px; padding: 6px 22px;
      font-size: 0.82rem; font-weight: 700; cursor: pointer;
      font-family: 'Inter', sans-serif; transition: var(--transition);
    }
    .drp-btn-ok:hover {
      background: var(--accent-blue); color: #0f1323;
      box-shadow: 0 0 14px rgba(0,212,255,0.35);
    }
    .drp-btn-ok:disabled { opacity: 0.4; cursor: not-allowed; }
    /* ===== FIN DEL SELECTOR DE RANGO DE FECHAS ===== */
  </style>
</head>
<body>
  <!-- Capa de Carga Global -->
  <div id="global-loader">
    <div class="spinner"></div>
    <div class="loading-text">Cargando Datos...</div>
  </div>

  <!-- Contenedor de Notificaciones (Toasts) -->
  <div id="toast-container" class="toast-container">
    <% if flash[:error_detail] %>
      <div class="toast toast-error" 
           style="animation: toastSlideIn 0.3s forwards;"
           onclick="this.style.animation='toastFadeOut 0.3s forwards'; setTimeout(()=>this.remove(), 300)">
        <span class="toast-icon">⚠️</span>
        <div class="toast-content"><%= flash[:error_detail] %></div>
      </div>
      <script>
        // Asegurar que el flash de error dure lo mismo que los toasts dinámicos
        setTimeout(() => {
          const flashToast = document.querySelector('.toast-error');
          if (flashToast) {
            flashToast.style.animation = 'toastFadeOut 0.3s forwards';
            setTimeout(() => flashToast.remove(), 300);
          }
        }, 20000);
      </script>
    <% end %>
  </div>

  <script>
    // Mostrar loader en navegación Turbo usando la función global con timeout
    document.addEventListener("turbo:visit", () => {
      if (window.showLoader) window.showLoader();
    });
    
    // Escuchar cuando Turbo termina de cargar para ocultar el cargador
    document.addEventListener("turbo:load", () => {
      if (window.hideLoader) window.hideLoader();
    });

    // Función global para mostrar el cargador manualmente
    window.showLoader = function() {
      const loader = document.getElementById("global-loader");
      if (loader) {
        loader.classList.add("active");
        // Failsafe: ocultar tras 5 segundos si algo falla
        clearTimeout(window.loaderTimeout);
        window.loaderTimeout = setTimeout(window.hideLoader, 5000);
      }
    };
    
    // Función global para ocultar el cargador manualmente
    window.hideLoader = function() {
      const loader = document.getElementById("global-loader");
      if (loader) loader.classList.remove("active");
      clearTimeout(window.loaderTimeout);
    };

    // Monitoreo de errores JS globales para retroalimentación visual
    window.onerror = function(message, source, lineno, colno, error) {
      const msg = `Error JS: ${message} en ${source}:${lineno}`;
      console.error(msg, error);
      // Intentar mostrar como toast si el controlador dashboard está cargado
      const dash = document.querySelector('[data-controller="dashboard"]');
      if (dash) {
        const controller = application.getControllerForElementAndIdentifier(dash, "dashboard");
        if (controller) controller.showToast(msg, 'error');
      }
      return false;
    };
  </script>

  <%= yield %>

  <!-- Capa Estática para el Datepicker -->
  <div class="drp-popup-overlay" id="main-drp-overlay"></div>
</body>
</html>
