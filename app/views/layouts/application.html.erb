    // ===== MÓDULO DE SELECTOR DE RANGO DE FECHAS (DATE RANGE PICKER) =====
    (function() {
      const MES_ES = ['Enero','Febrero','Marzo','Abril','Mayo','Junio',
                      'Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
      const MES_ES_SHORT = ['ene','feb','mar','abr','may','jun',
                            'jul','ago','sep','oct','nov','dic'];
      const DAYS_SHORT = ['Lu','Ma','Mi','Ju','Vi','Sá','Do'];
      const MIN_YEAR = 2025;
      const MAX_YEAR = new Date().getFullYear();

      function pad(n){ return String(n).padStart(2,'0'); }
      function fmtDate(d){ return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`; }

      function buildLabel(start, end) {
        if (!start && !end) return 'Rango de fechas';
        if (start && !end)  return `${start.getDate()} ${MES_ES_SHORT[start.getMonth()]} → …`;
        
        // Caso especial: Todo el año
        if (start && end && start.getMonth() === 0 && start.getDate() === 1 && end.getMonth() === 11 && end.getDate() === 31) {
          return `Todo el año ${start.getFullYear()}`;
        }
        
        const year  = end.getFullYear();
        const month = MES_ES[end.getMonth()].toLowerCase();
        return `${year} ${month} ${start.getDate()}->${end.getDate()}`;
      }

      function createPicker(trigger, hiddenStart, hiddenEnd) {
        // Estado interno
        let selStart = hiddenStart.value ? new Date(hiddenStart.value + 'T00:00:00') : null;
        let selEnd   = hiddenEnd.value   ? new Date(hiddenEnd.value   + 'T00:00:00') : null;
        let step     = selStart ? (selEnd ? 0 : 1) : 0;
        let viewYear, viewMonth;
        let mode = 'days';

        const today = new Date();
        if (selEnd) {
          viewYear  = selEnd.getFullYear();
          viewMonth = selEnd.getMonth();
        } else {
          viewYear  = today.getFullYear();
          viewMonth = today.getMonth();
        }

        // === Usar superposición estática ===
        const overlay = document.getElementById('main-drp-overlay');
        if (!overlay) {
          console.error('[DRP] Overlay estático no encontrado');
          return;
        }
        
        // El contenido se regenera cada vez que se abre para este trigger específico
        function openPicker() {
          overlay.innerHTML = `
            <div class="drp-popup">
              <div class="drp-header">
                <button class="drp-nav-btn drp-prev" type="button">&#8249;</button>
                <div class="drp-month-year">
                  <button class="drp-month-btn drp-month-lbl" type="button"></button>
                  <button class="drp-year-btn drp-year-lbl" type="button"></button>
                </div>
                <button class="drp-nav-btn drp-next" type="button">&#8250;</button>
              </div>
              <div class="drp-panel drp-month-panel"></div>
              <div class="drp-panel drp-year-panel"></div>
              <div class="drp-day-area">
                <div class="drp-weekdays">${DAYS_SHORT.map(d=>`<span>${d}</span>`).join('')}</div>
                <div class="drp-days"></div>
              </div>
              <div class="drp-status"></div>
              <div class="drp-footer">
                <button class="drp-btn-reset" type="button">Resetear</button>
                <button class="drp-btn-ok" type="button">OK</button>
              </div>
            </div>`;
          
          overlay.classList.add('open');
          
          const card       = overlay.querySelector('.drp-popup');
          const monthLbl   = overlay.querySelector('.drp-month-lbl');
          const yearLbl    = overlay.querySelector('.drp-year-lbl');
          const prevBtn    = overlay.querySelector('.drp-prev');
          const nextBtn    = overlay.querySelector('.drp-next');
          const daysEl     = overlay.querySelector('.drp-days');
          const dayArea    = overlay.querySelector('.drp-day-area');
          const monthPanel = overlay.querySelector('.drp-month-panel');
          const yearPanel  = overlay.querySelector('.drp-year-panel');
          const statusEl   = overlay.querySelector('.drp-status');
          const resetBtn   = overlay.querySelector('.drp-btn-reset');
          const okBtn      = overlay.querySelector('.drp-btn-ok');

          function updateHeader() {
            monthLbl.textContent = MES_ES[viewMonth];
            yearLbl.textContent  = viewYear;
          }

          function updateStatus() {
            if (!selStart && !selEnd) {
              statusEl.innerHTML = `Se filtrará por <span class="drp-start-lbl">todo el año ${viewYear}</span>`;
            } else if (selStart && !selEnd) {
              statusEl.innerHTML = `<span class="drp-start-lbl">Inicio: ${selStart.getDate()} ${MES_ES_SHORT[selStart.getMonth()]} ${selStart.getFullYear()}</span><span class="drp-arrow"> → </span>Selecciona la <span class="drp-end-lbl">fecha fin</span>`;
            } else {
              statusEl.innerHTML = `<span class="drp-start-lbl">Inicio: ${selStart.getDate()} ${MES_ES_SHORT[selStart.getMonth()]} ${selStart.getFullYear()}</span><span class="drp-arrow"> → </span><span class="drp-end-lbl">Fin: ${selEnd.getDate()} ${MES_ES_SHORT[selEnd.getMonth()]} ${selEnd.getFullYear()}</span>`;
            }
            // Habilitar OK si ambos están seleccionados O si ambos están vacíos (filtrar por año completo)
            okBtn.disabled = (selStart && !selEnd);
          }

          function renderDays() {
            daysEl.innerHTML = '';
            const firstDay = new Date(viewYear, viewMonth, 1).getDay();
            const offset = (firstDay + 6) % 7;
            const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

            for (let i = 0; i < offset; i++) {
              const empty = document.createElement('button');
              empty.className = 'drp-day drp-day-empty';
              empty.setAttribute('type', 'button');
              daysEl.appendChild(empty);
            }

            for (let d = 1; d <= daysInMonth; d++) {
              const date = new Date(viewYear, viewMonth, d);
              const btn  = document.createElement('button');
              btn.setAttribute('type', 'button');
              btn.className = 'drp-day';
              btn.textContent = d;

              const isStart = selStart && date.toDateString() === selStart.toDateString();
              const isEnd   = selEnd   && date.toDateString() === selEnd.toDateString();
              const inRange = selStart && selEnd && date > selStart && date < selEnd;

              if (isStart) btn.classList.add('drp-day-start');
              if (isEnd)   btn.classList.add('drp-day-end');
              if (inRange) btn.classList.add('drp-day-in-range');

              btn.addEventListener('click', () => onDayClick(date));
              daysEl.appendChild(btn);
            }
          }

          function renderMonthPanel() {
            monthPanel.innerHTML = '';
            MES_ES.forEach((m, i) => {
              const btn = document.createElement('button');
              btn.setAttribute('type', 'button');
              btn.className = 'drp-panel-item' + (i === viewMonth ? ' active' : '');
              btn.textContent = m;
              btn.addEventListener('click', () => { viewMonth = i; showMode('days'); });
              monthPanel.appendChild(btn);
            });
          }

          function renderYearPanel() {
            yearPanel.innerHTML = '';
            for (let y = MIN_YEAR; y <= MAX_YEAR; y++) {
              const btn = document.createElement('button');
              btn.setAttribute('type', 'button');
              btn.className = 'drp-panel-item' + (y === viewYear ? ' active' : '');
              btn.textContent = y;
              btn.addEventListener('click', () => { viewYear = y; showMode('days'); });
              yearPanel.appendChild(btn);
            }
          }

          function showMode(m) {
            mode = m;
            dayArea.style.display    = (m === 'days')   ? '' : 'none';
            monthPanel.classList.toggle('open', m === 'months');
            yearPanel.classList.toggle('open',  m === 'years');
            prevBtn.style.visibility = (m === 'days') ? 'visible' : 'hidden';
            nextBtn.style.visibility = (m === 'days') ? 'visible' : 'hidden';
            updateHeader();
            if (m === 'months') renderMonthPanel();
            if (m === 'years')  renderYearPanel();
            if (m === 'days')   renderDays();
          }

          function onDayClick(date) {
            if (step === 0) {
              selStart = date; selEnd = null; step = 1;
            } else {
              if (date < selStart) { selEnd = selStart; selStart = date; }
              else { selEnd = date; }
              step = 0;
            }
            renderDays(); updateStatus();
          }

          prevBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            viewMonth--;
            if (viewMonth < 0) { viewMonth = 11; viewYear--; }
            if (viewYear < MIN_YEAR) { viewYear = MIN_YEAR; viewMonth = 0; }
            renderDays(); updateHeader();
          });
          nextBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            viewMonth++;
            if (viewMonth > 11) { viewMonth = 0; viewYear++; }
            if (viewYear > MAX_YEAR) { viewYear = MAX_YEAR; viewMonth = 11; }
            renderDays(); updateHeader();
          });

          monthLbl.addEventListener('click', (e) => { e.stopPropagation(); showMode(mode === 'months' ? 'days' : 'months'); });
          yearLbl.addEventListener('click',  (e) => { e.stopPropagation(); showMode(mode === 'years'  ? 'days' : 'years'); });

          resetBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            selStart = null; selEnd = null; step = 0;
            renderDays(); updateStatus();
          });

          okBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            
            let finalStart = selStart;
            let finalEnd = selEnd;
            
            // Si no hay selección manual, usamos el año completo que se está visualizando
            if (!finalStart && !finalEnd) {
              finalStart = new Date(viewYear, 0, 1);
              finalEnd   = new Date(viewYear, 11, 31);
            }
            
            if (!finalStart || !finalEnd) return;
            
            hiddenStart.value = fmtDate(finalStart);
            hiddenEnd.value   = fmtDate(finalEnd);
            trigger.querySelector('.drp-label').textContent = buildLabel(finalStart, finalEnd);
            overlay.classList.remove('open');
            overlay.innerHTML = '';
            const fc = document.getElementById('filter-form');
            if (fc) fc.dispatchEvent(new Event('drp:changed', { bubbles: true }));
          });

          overlay.onclick = (e) => {
            if (e.target === overlay) {
              overlay.classList.remove('open');
              overlay.innerHTML = '';
            }
          };

          showMode('days');
          updateStatus();
        }

        // Abrir al hacer clic en el disparador
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          openPicker();
        });

        // Inicializar etiqueta con valores existentes
        trigger.querySelector('.drp-label').textContent = buildLabel(selStart, selEnd);
      }

      // Inicialización — evita doble carga con una bandera en el elemento
      function initPickers() {
        document.querySelectorAll('[data-drp-trigger]').forEach(trigger => {
          if (trigger._drpReady) return; 
          trigger._drpReady = true;

          const hs = document.getElementById(trigger.dataset.drpStart);
          const he = document.getElementById(trigger.dataset.drpEnd);
          if (hs && he) {
            // Eliminar overlays huérfanos si existen (limpieza ante recargas parciales de Turbo)
            const oldOverlays = document.querySelectorAll('.drp-popup-overlay');
            if (oldOverlays.length > 5) { // Umbral de seguridad
              oldOverlays.forEach((o, i) => { if (i < oldOverlays.length - 1) o.remove(); });
            }
            createPicker(trigger, hs, he);
          }
        });
      }

      // turbo:load se dispara tanto en la carga inicial como en navegaciones de Turbo.
      // DOMContentLoaded no es necesario aquí porque turbo:load lo supera.
      document.addEventListener('turbo:load', initPickers);
      // Respaldo para páginas sin Turbo
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPickers);
      } else {
        initPickers();
      }
    })();
    console.log("Módulos de Date Range Picker y Stimulus ejecutados");
    // ===== FIN DEL MÓDULO SELECTOR DE RANGO DE FECHAS =====

  </script>



  <style>
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

