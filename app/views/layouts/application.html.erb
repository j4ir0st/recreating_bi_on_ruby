                    } else if (value >= 1000) {
                      formatted = 'S/ ' + (value/1000).toFixed(0) + ' mil';
                    } else {
                      formatted = 'S/ ' + value.toLocaleString('es-PE', {minimumFractionDigits: 2});
                    }
                    return context.dataset.label + ': ' + formatted;
                  }
                }
              }
            },
            scales: {
              x: {
                grid: { color: 'rgba(255,255,255,0.04)', drawBorder: false },
                ticks: { color: '#a0aec0', font: { family: 'Inter', size: 11 } }
              },
              y: {
                grid: { color: 'rgba(255,255,255,0.04)', drawBorder: false },
                ticks: {
                  color: '#a0aec0',
                  font: { family: 'Inter', size: 11 },
                  callback: function(value) {
                    if (value >= 1000000) return 'S/ ' + (value/1000000).toFixed(1) + ' mill.';
                    if (value >= 1000) return 'S/ ' + (value/1000).toFixed(0) + ' mil';
                    return 'S/ ' + value;
                  }
                }
              }
            }
          }
        });
      }
