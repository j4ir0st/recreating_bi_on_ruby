<div class="auth-card">
  <div class="auth-header">
    <h1>Iniciar Sesión</h1>
    <p>Ingresa tus credenciales para continuar</p>
  </div>

  <% if flash[:alert] %>
    <div class="alert alert-danger"><%= flash[:alert] %></div>
  <% end %>
  <% if flash[:notice] %>
    <div class="alert alert-success"><%= flash[:notice] %></div>
  <% end %>

  <%= form_with url: login_path, local: true, data: { controller: "login", action: "submit->login#submit" } do |f| %>
    <div class="form-group">
      <%= f.label :username, "Usuario / Correo" %>
      <%= f.text_field :username, class: "form-control", required: true, autofocus: true, placeholder: "ej. usuario" %>
    </div>

    <div class="form-group">
      <%= f.label :password, "Contraseña" %>
      <div style="position: relative;" data-controller="password-visibility">
        <%= f.password_field :password, class: "form-control", required: true, placeholder: "••••••••", 
                             data: { password_visibility_target: "input" }, 
                             style: "padding-right: 50px;" %>
        <button type="button" 
                data-action="password-visibility#toggle" 
                style="position: absolute; right: 0; top: 0; bottom: 0; width: 45px; background: none; border: none; color: var(--accent-blue); cursor: pointer; display: flex; align-items: center; justify-content: center; z-index: 10;">
          <span data-password-visibility-target="icon" style="pointer-events: none; display: flex; opacity: 0.8;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </span>
        </button>
      </div>
    </div>

    <div class="form-group" style="margin-top: 32px;">
      <button type="submit" class="btn-primary" data-login-target="button">
        <span data-login-target="text">Entrar al Dashboard</span>
        <div data-login-target="loader" class="btn-loader" style="display: none;"></div>
      </button>
    </div>
  <% end %>
</div>
