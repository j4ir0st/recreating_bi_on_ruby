<div class="auth-card">
  <div class="auth-header">
    <h1>Iniciar Sesión</h1>
    <p>Ingresa tus credenciales para continuar</p>
  </div>

  <% if flash[:alert] %>
    <div class="alert alert-danger"><%= flash[:alert] %></div>
  <% end %>
  <% if flash[:notice] %>
    <div class="alert alert-success"><%= flash[:notice] %></div>
  <% end %>

  <%= form_with url: login_path, local: true do |f| %>
    <div class="form-group">
      <%= f.label :username, "Usuario / Correo" %>
      <%= f.text_field :username, class: "form-control", required: true, autofocus: true, placeholder: "ej. usuario" %>
    </div>

    <div class="form-group">
      <%= f.label :password, "Contraseña" %>
      <%= f.password_field :password, class: "form-control", required: true, placeholder: "••••••••" %>
    </div>

    <div class="form-group">
      <%= f.submit "Entrar al Dashboard", class: "btn-primary" %>
    </div>
  <% end %>
</div>
